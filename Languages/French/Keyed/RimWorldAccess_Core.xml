<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Core module strings (src/Core/). Five files contribute, but most produce
    no player-facing output:

      - rimworld_access.cs          (entry point — Log.* only, intentionally English)
      - GameStartPatch.cs           (no user-facing strings)
      - ModLogger.cs                (logging helper — intentionally English)
      - ReloadHelper.cs             (#if DEBUG hot-reload — dev-only TolkHelper
                                     lines are intentionally English)
      - RimWorldAccessSettings.cs   (the Mod Settings panel — THIS file's scope)

    Intentionally left in English per docs/decisions.md Decision 5:
      * Every Log.Message / Log.Warning / Log.Error in rimworld_access.cs
        ("Initializing accessibility features...", "Applying Harmony patches...",
        "Total patches applied: {count}", "Main menu keyboard navigation
        enabled!", "Use Arrow keys to navigate, Enter to select.",
        "Tearing down for reload...", "Shutting down...", etc.) — these go to
        RimWorld's debug console for bug triage, not to players.
      * ModLogger prefix "[RimWorld Access] " — log decoration.
      * ReloadHelper.cs TolkHelper.Speak announcements ("Reloading RimWorld
        Access", "RimWorld Access reloaded", "Reload failed: ...") — the
        entire file is wrapped in #if DEBUG and only fires in the developer
        hot-reload path, never in a shipped player build.
      * "[RimWorld Access] Settings loaded." Log.Message in the Mod ctor.

    The keys below cover the only truly player-facing surface in this
    module: the Options > Mod Settings panel for RimWorld Access.
  -->

  <!-- Settings panel category name (RimWorldAccessMod_Settings.SettingsCategory).
       Shown as the row label in Options > Mod Settings. Translators may keep
       "RimWorld Access" verbatim (brand name) or transliterate/adjust
       capitalization for their locale. -->
  <RimWorldAccess.Core.Settings.Category>RimWorld Access</RimWorldAccess.Core.Settings.Category>

  <!-- Checkbox labels in DoSettingsWindowContents, top-to-bottom order.
       Each one toggles a single RimWorldAccessSettings bool. The parenthetical
       examples are part of the label — translators should adapt the example
       text (e.g. "3 of 7", "level 2") so it matches how the corresponding
       announcement is phrased in their language. -->
  <RimWorldAccess.Core.Settings.WrapNavigation.Label>Navigation en boucle</RimWorldAccess.Core.Settings.WrapNavigation.Label>
  <RimWorldAccess.Core.Settings.ShowPawnActivityOnMap.Label>Afficher l'activité des personnages au déplacement du curseur sur la carte</RimWorldAccess.Core.Settings.ShowPawnActivityOnMap.Label>
  <RimWorldAccess.Core.Settings.ShowCoverInfo.Label>Afficher les informations de couverture pour les personnages mobilisés et hostiles</RimWorldAccess.Core.Settings.ShowCoverInfo.Label>
  <RimWorldAccess.Core.Settings.AnnounceTerrain.Label>Annoncer le terrain au déplacement du curseur</RimWorldAccess.Core.Settings.AnnounceTerrain.Label>
  <RimWorldAccess.Core.Settings.HoverSpeech.Label>Suivi de la souris</RimWorldAccess.Core.Settings.HoverSpeech.Label>
  <RimWorldAccess.Core.Settings.HoverSpeech.Desc>Annonce ce qui se trouve sous la souris pendant son déplacement.</RimWorldAccess.Core.Settings.HoverSpeech.Desc>
  <RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Label>Le pointeur de la souris suit le curseur du clavier</RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Label>
  <RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Desc>Place le pointeur de la souris sur la case du curseur clavier après chaque déplacement. {0} pour l'ajuster en jeu.</RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Desc>
  <RimWorldAccess.Core.Settings.ScannerAutoJump.Label>Saut automatique du scanner</RimWorldAccess.Core.Settings.ScannerAutoJump.Label>
  <RimWorldAccess.Core.Settings.ScannerAutoJump.Desc>Déplace le curseur sur chaque élément du scanner pendant la navigation. {0} pour l'ajuster en jeu.</RimWorldAccess.Core.Settings.ScannerAutoJump.Desc>

  <!-- Opens the Configure Spoken Announcements screen (a real window, not this panel);
       see RimWorldAccess_AnnounceConfig.xml for that screen's own strings. -->
  <RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button>Configurer les annonces vocales...</RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button>

  <!-- SubmenuTreeNavigation is the only checkbox with a tooltip. The label is
       deliberately whimsical ("Rashad Hates Treeviews") — translators can
       preserve the joke or replace it with something equivalent in their
       culture as long as it still telegraphs what the setting does. The
       tooltip is the canonical explanation. -->
  <RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Label>Rashad déteste les arborescences (navigation façon sous-menu)</RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Label>
  <RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Tooltip>Change le fonctionnement des arborescences. Quand vous développez une catégorie, elle disparaît et vous ne naviguez plus que dans ses éléments. Appuyez sur la flèche gauche pour revenir en arrière. Votre position est mémorisée à votre retour.</RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Tooltip>

  <RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Label>Annoncer l'activité du personnage sélectionné</RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Label>
  <RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Desc>Annonce en temps réel ce que fait le personnage sélectionné. Déplacer le curseur de la carte arrête les annonces.</RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Desc>

  <RimWorldAccess.Core.Settings.ShowWhatsNew.Label>Afficher le message Quoi de neuf après une mise à jour</RimWorldAccess.Core.Settings.ShowWhatsNew.Label>
  <RimWorldAccess.Core.Settings.ShowWhatsNew.Desc>Lorsque cette option est activée, le message Quoi de neuf s'ouvre dans le menu principal après une mise à jour de RimWorld Access. Lorsqu'elle est désactivée, vous entendez seulement un bref avis indiquant que le mod a été mis à jour, et vous pouvez ouvrir Quoi de neuf depuis le menu à tout moment.</RimWorldAccess.Core.Settings.ShowWhatsNew.Desc>

  <!-- Table verbosity (docs/table-model.md). The examples inside the labels
       should be adapted to match each language's actual table announcements. -->
</LanguageData>
