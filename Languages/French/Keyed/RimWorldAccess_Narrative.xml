<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Narrative Feed (speech mods campaign, src/Narrative/NarrativeFeed.Game.cs).
    Grammar keys compose one spoken line of ambient dialogue/narration; the
    caller picks the variant based on which of speaker/recipient resolved.
    {0}/{1}/{2} are already-resolved passthrough strings (pawn LabelShort,
    line text) via .Translate(args), not authored prose fragments.
  -->
  <RimWorldAccess.Narrative.LineTo>{0} à {1}: {2}</RimWorldAccess.Narrative.LineTo>
  <RimWorldAccess.Narrative.Line>{0}: {1}</RimWorldAccess.Narrative.Line>
  <RimWorldAccess.Narrative.System>{0}</RimWorldAccess.Narrative.System>

  <!--
    The stable-read rule's shared marker (speech mods campaign S15, src/Narrative/AsyncTextStability.Game.cs).
    Spoken INSTEAD OF any in-flight streamed/generated text while an extension mod's async
    rewrite is still running, never a fragment of the real text. See Literature's book/art
    inspection-tree children (S15) and S16 Quests for riders.
  -->
  <RimWorldAccess.Narrative.StillBeingWritten>Encore en cours d'écriture.</RimWorldAccess.Narrative.StillBeingWritten>

  <!-- Settings (Main Menu > Options > RimWorld Access), src/Shell/Screens/OptionsRwaCategory.Game.cs. -->
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>Annoncer les dialogues générés des colons</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>Lit les répliques écrites par des mods narratifs comme RimTalk.</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>Annoncer les bulles d'interaction du jeu de base</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>Lit les échanges sociaux du jeu lui-même. Nécessite le mod Interaction Bubbles de Jaxe.</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>Annoncer le dialogue même lorsque le module TTS de RimTalk le dit déjà à voix haute</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>Quand ce paramètre est désactivé, le lecteur d'écran reste silencieux pour une ligne pendant que le module TTS de RimTalk la dit à voix haute ; le journal des dialogues continue de l'enregistrer.</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>

