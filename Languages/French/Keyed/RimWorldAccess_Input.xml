<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Input module strings (src/Input/). Two files contribute:
      - UnifiedKeyboardPatch.cs  (central keyboard router with ~40 speak calls)
      - MapArrowKeyHandler.cs    (map arrow-key navigation prefixes + boundary)

    Text-input strings live in RimWorldAccess_TextInput.xml and are owned by
    the Input/TextInput/ subsystem; do not duplicate them here.

    The Drafting.* and Forbid.* keys have One/Many splits so translators can
    give singular and plural subject-verb agreement natural wording. The
    MultiSelectOrder.* keys are whole phrases per semantic case, mirroring
    the pattern in RimWorldAccess_Combat.xml's MultiSelect.* entries.
  -->

  <!-- Close / exit announcements. -->
  <RimWorldAccess.Input.Close.ReturnedToMap>Retour à la carte</RimWorldAccess.Input.Close.ReturnedToMap>
  <RimWorldAccess.Input.Close.MenuClosed>Menu fermé</RimWorldAccess.Input.Close.MenuClosed>
  <RimWorldAccess.Input.Close.GizmoMenuClosed>Menu des commandes fermé</RimWorldAccess.Input.Close.GizmoMenuClosed>

  <!-- Drafting (B key). Singular "{name} Drafted" / "{name} Undrafted" for
       single-select, "everyone" / "only" / "except" phrases for multi-select.
       Status is capitalized at the start of a sentence; lower-case variants
       are used mid-phrase. -->
  <RimWorldAccess.Input.Drafting.StatusDraftedTitle>Mobilisé</RimWorldAccess.Input.Drafting.StatusDraftedTitle>
  <RimWorldAccess.Input.Drafting.StatusUndraftedTitle>Démobilisé</RimWorldAccess.Input.Drafting.StatusUndraftedTitle>
  <RimWorldAccess.Input.Drafting.StatusDrafted>mobilisé</RimWorldAccess.Input.Drafting.StatusDrafted>
  <RimWorldAccess.Input.Drafting.StatusUndrafted>démobilisé</RimWorldAccess.Input.Drafting.StatusUndrafted>
  <!-- {0} = pawn name, {1} = status (Drafted/Undrafted, capitalized). -->
  <RimWorldAccess.Input.Drafting.SinglePawnStatus>{0} {1}</RimWorldAccess.Input.Drafting.SinglePawnStatus>
  <!-- Multi-select drafting announcements. {0} = everyone-label from vanilla
       key, {1} = name-list, {2} = status (drafted/undrafted, lowercase). -->
  <RimWorldAccess.Input.Drafting.EveryoneStatus>{0} {1}</RimWorldAccess.Input.Drafting.EveryoneStatus>
  <RimWorldAccess.Input.Drafting.EveryoneExceptStatus>{0} sauf {1} {2}</RimWorldAccess.Input.Drafting.EveryoneExceptStatus>
  <RimWorldAccess.Input.Drafting.OnlyStatus>Seulement {0}: {1}</RimWorldAccess.Input.Drafting.OnlyStatus>

  <!-- Multi-select action feedback for right-bracket / left-bracket order
       menus. Whole phrases so translators can reorder subject/verb/object.
       {0} = everyone-label (EveryoneDoes/NoOneCould/EveryoneExcept) or
             name-list (OnlyDoes), {1} = action label or name-list,
       {2} = action label (EveryoneExcept only). -->
  <RimWorldAccess.Input.MultiSelectOrder.EveryoneDoes>{0} {1}</RimWorldAccess.Input.MultiSelectOrder.EveryoneDoes>
  <RimWorldAccess.Input.MultiSelectOrder.NoOneCould>Personne n'a pu {0}</RimWorldAccess.Input.MultiSelectOrder.NoOneCould>
  <RimWorldAccess.Input.MultiSelectOrder.EveryoneExcept>{0} sauf {1} {2}</RimWorldAccess.Input.MultiSelectOrder.EveryoneExcept>
  <RimWorldAccess.Input.MultiSelectOrder.OnlyDoes>Seulement {0} {1}</RimWorldAccess.Input.MultiSelectOrder.OnlyDoes>

  <!-- Multi-select guards (Alt+Space group management, reorder). -->
  <RimWorldAccess.Input.MultiSelect.NoColonistsOnMap>Aucun colon sur cette carte</RimWorldAccess.Input.MultiSelect.NoColonistsOnMap>
  <RimWorldAccess.Input.MultiSelect.CannotSaveGroups>Impossible d'enregistrer des groupes hors d'une partie</RimWorldAccess.Input.MultiSelect.CannotSaveGroups>
  <RimWorldAccess.Input.MultiSelect.CannotRecallGroups>Impossible de rappeler des groupes hors d'une partie</RimWorldAccess.Input.MultiSelect.CannotRecallGroups>
  <RimWorldAccess.Input.MultiSelect.CannotReorderDuringMultiSelect>Impossible de réorganiser pendant une sélection multiple</RimWorldAccess.Input.MultiSelect.CannotReorderDuringMultiSelect>

  <!-- Cursor-focused actions (rename at cursor, inspection at cursor). -->
  <RimWorldAccess.Input.Cursor.NoPawnAtCursor>Aucun personnage sous le curseur</RimWorldAccess.Input.Cursor.NoPawnAtCursor>
  <RimWorldAccess.Input.Cursor.PawnCannotBeRenamed>Ce personnage ne peut pas être renommé</RimWorldAccess.Input.Cursor.PawnCannotBeRenamed>
  <RimWorldAccess.Input.Cursor.NothingToInspect>Rien à explorer ici</RimWorldAccess.Input.Cursor.NothingToInspect>
  <RimWorldAccess.Input.Cursor.InvalidPosition>Position invalide</RimWorldAccess.Input.Cursor.InvalidPosition>
  <RimWorldAccess.Input.Cursor.NoAvailableActions>Aucune action disponible</RimWorldAccess.Input.Cursor.NoAvailableActions>
  <RimWorldAccess.Input.Cursor.Coordinates>{0}, {1}</RimWorldAccess.Input.Cursor.Coordinates>

  <!-- Mouse pointer bridge (Alt+J). PointerOffset is the answer when the pointer cannot
       be moved: {0} = tile distance, {1} = compass direction of the cursor from it. -->
  <RimWorldAccess.Input.Cursor.PointerMoved>Pointeur à {0}, {1}</RimWorldAccess.Input.Cursor.PointerMoved>
  <RimWorldAccess.Input.Cursor.PointerOffset>Curseur à {0} cases {1} du pointeur</RimWorldAccess.Input.Cursor.PointerOffset>
  <RimWorldAccess.Input.Cursor.PointerAtCursor>Pointeur sur le curseur</RimWorldAccess.Input.Cursor.PointerAtCursor>
  <RimWorldAccess.Input.Cursor.PointerOffWindow>Le pointeur est hors de la fenêtre du jeu</RimWorldAccess.Input.Cursor.PointerOffWindow>
  <RimWorldAccess.Input.Cursor.MouseTrackingOn>Suivi de la souris activé</RimWorldAccess.Input.Cursor.MouseTrackingOn>
  <RimWorldAccess.Input.Cursor.MouseTrackingOff>Suivi de la souris désactivé</RimWorldAccess.Input.Cursor.MouseTrackingOff>
  <RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOn>Pointeur lié au clavier activé</RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOn>
  <RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOff>Pointeur lié au clavier désactivé</RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOff>

  <!-- F1 work menu, F4 animals/mechs menu. -->
  <RimWorldAccess.Input.WorkMenu.NoColonistsAvailable>Aucun colon disponible</RimWorldAccess.Input.WorkMenu.NoColonistsAvailable>
  <RimWorldAccess.Input.AnimalsMenu.NoAnimalsOrMechs>Aucun animal ni mécanoïde</RimWorldAccess.Input.AnimalsMenu.NoAnimalsOrMechs>

  <!-- Gizmo availability guard (G key). -->

  <!-- Right/left bracket order execution feedback. -->
  <!-- {0} = single-pawn prefix ("Bob: " or ""), {1} = action label. -->
  <RimWorldAccess.Input.Order.TopOptionUnavailable>{0}{1}, indisponible</RimWorldAccess.Input.Order.TopOptionUnavailable>
  <!-- {0} = pawn name, {1} = action label, {2} = vanilla "Queued" label. -->
  <RimWorldAccess.Input.Order.QueuedAction>{0}: {1}, {2}</RimWorldAccess.Input.Order.QueuedAction>
  <!-- {0} = pawn name, {1} = action label. -->
  <RimWorldAccess.Input.Order.Action>{0}: {1}</RimWorldAccess.Input.Order.Action>
  <!-- {0} = GoHere label from vanilla. Suffix marks the line-formation variant. -->
  <RimWorldAccess.Input.Order.FormationOption>{0} (formation)</RimWorldAccess.Input.Order.FormationOption>

  <!-- Unforbid All (Alt+F). One/Many split for subject-verb agreement. -->
  <RimWorldAccess.Input.Unforbid.NoForbiddenItems>Aucun objet interdit trouvé sur la carte</RimWorldAccess.Input.Unforbid.NoForbiddenItems>
  <RimWorldAccess.Input.Unforbid.CountOne>1 objet autorisé</RimWorldAccess.Input.Unforbid.CountOne>
  <RimWorldAccess.Input.Unforbid.CountMany>{0} objets autorisés</RimWorldAccess.Input.Unforbid.CountMany>

  <!-- Toggle forbid at cursor (F key). One/Many + forbidden/unforbidden
       splits so translators can give the plural subject correct agreement. -->
  <RimWorldAccess.Input.Forbid.NothingToForbid>Rien à interdire ou autoriser à cet endroit</RimWorldAccess.Input.Forbid.NothingToForbid>
  <!-- {0} = item label. -->
  <RimWorldAccess.Input.Forbid.SingleForbidden>{0} interdit</RimWorldAccess.Input.Forbid.SingleForbidden>
  <RimWorldAccess.Input.Forbid.SingleUnforbidden>{0} n'est plus interdit</RimWorldAccess.Input.Forbid.SingleUnforbidden>
  <!-- {0} = toggled count. -->
  <RimWorldAccess.Input.Forbid.ManyForbidden>{0} objets interdits</RimWorldAccess.Input.Forbid.ManyForbidden>
  <RimWorldAccess.Input.Forbid.ManyUnforbidden>{0} objets ne sont plus interdits</RimWorldAccess.Input.Forbid.ManyUnforbidden>

  <!-- Map arrow-key navigation prefixes (MapArrowKeyHandler.cs).
       Composed with the tile info that follows, e.g. "Selected, stone, ...".
       {0} = tile info. -->
  <RimWorldAccess.Input.Map.Boundary>Limite de la carte</RimWorldAccess.Input.Map.Boundary>
  <RimWorldAccess.Input.Map.PrefixSelected>Sélectionné, {0}</RimWorldAccess.Input.Map.PrefixSelected>
  <RimWorldAccess.Input.Map.PrefixFirstPoint>Premier point, {0}</RimWorldAccess.Input.Map.PrefixFirstPoint>
  <RimWorldAccess.Input.Map.PrefixSecondPoint>Deuxième point, {0}</RimWorldAccess.Input.Map.PrefixSecondPoint>
  <RimWorldAccess.Input.Map.PrefixInArea>Dans la zone, {0}</RimWorldAccess.Input.Map.PrefixInArea>
  <RimWorldAccess.Input.Map.PrefixDisconnected>Déconnecté, {0}</RimWorldAccess.Input.Map.PrefixDisconnected>

  <!-- Schedule editor visual overlay (src/Input/UnifiedKeyboardPatch.cs). -->
</LanguageData>
