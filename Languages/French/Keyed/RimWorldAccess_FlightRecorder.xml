<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    QA flight recorder (src/Shell/Compat/FlightRecorder.Game.cs). Alt (Option on macOS) plus
    the vanilla screenshot key starts and stops a recording anywhere; stopping opens
    Dialog_RecordingSaved with the saved path unless suppressed. The two Settings keys are the
    suppression toggle's row in both RimWorld Access settings surfaces.
  -->
  <RimWorldAccess.FlightRecorder.Started>Enregistreur de vol démarré.</RimWorldAccess.FlightRecorder.Started>
  <RimWorldAccess.FlightRecorder.Stopped>Enregistreur de vol arrêté.</RimWorldAccess.FlightRecorder.Stopped>
  <RimWorldAccess.FlightRecorder.StoppedWithPath>Enregistreur de vol arrêté. Enregistrement sauvegardé dans {0}.</RimWorldAccess.FlightRecorder.StoppedWithPath>
  <RimWorldAccess.FlightRecorder.Marker>Marqueur {0} enregistré.</RimWorldAccess.FlightRecorder.Marker>
  <RimWorldAccess.FlightRecorder.DialogTitle>Enregistrement sauvegardé</RimWorldAccess.FlightRecorder.DialogTitle>
  <RimWorldAccess.FlightRecorder.DialogBody>Le journal de l'enregistreur de vol a été sauvegardé dans : {0}</RimWorldAccess.FlightRecorder.DialogBody>
  <RimWorldAccess.FlightRecorder.DontShowAgain>Ne plus afficher cette fenêtre</RimWorldAccess.FlightRecorder.DontShowAgain>
  <RimWorldAccess.FlightRecorder.OpenFolder>Ouvrir le dossier</RimWorldAccess.FlightRecorder.OpenFolder>
  <RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Label>Afficher une fenêtre quand un enregistrement de vol est sauvegardé</RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Label>
  <RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Desc>Quand une session de l'enregistreur de vol s'arrête ({0}), ouvre une fenêtre indiquant l'emplacement du fichier sauvegardé. Sinon, l'emplacement est annoncé vocalement.</RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Desc>
</LanguageData>
