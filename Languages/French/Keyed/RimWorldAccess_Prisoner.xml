<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Prisoner module strings (src/Prisoner/). Three files contribute:
      - PrisonerTabPatch.cs    (Harmony patch, no user-facing text)
      - PrisonerTabHelper.cs   (info/stats formatting, interaction descriptions)
      - PrisonerTabState.cs    (tab navigation, section announcements, selections)

    Placeholders follow string.Format ({0}, {1}, ...). Many keys embed
    pawn names, def labels, faction names, or raw numbers/percentages that
    come from the game's own data - do not attempt to translate the
    substituted values, only the surrounding wording. Shared vocabulary
    (e.g. "No pawn selected") is sourced from RimWorldAccess_Common.xml
    through GuardHelper, so it is not duplicated here.
  -->

  <!-- Guest-tracker / identity fallbacks. Spoken when a pawn lacks the
       expected tracker component or does not belong to the expected class.
       {0} = pawn short label. -->
  <RimWorldAccess.Prisoner.Guest.NoTracker>{0}: Aucun suivi d'invité</RimWorldAccess.Prisoner.Guest.NoTracker>
  <RimWorldAccess.Prisoner.Guest.NotPrisoner>{0}: Pas un prisonnier</RimWorldAccess.Prisoner.Guest.NotPrisoner>
  <RimWorldAccess.Prisoner.Guest.NotSlave>{0}: Pas un esclave</RimWorldAccess.Prisoner.Guest.NotSlave>
  <RimWorldAccess.Prisoner.Guest.NotPrisonerOrSlave>{0} n'est ni prisonnier ni esclave</RimWorldAccess.Prisoner.Guest.NotPrisonerOrSlave>

  <!-- Prisoner stats block. Fragments are clean phrases; the
       AnnouncementBuilder owns separators between them. -->
  <RimWorldAccess.Prisoner.Info.HeaderPrisoner>{0} - Prisonnier</RimWorldAccess.Prisoner.Info.HeaderPrisoner>
  <RimWorldAccess.Prisoner.Info.HeaderSlave>{0} - Esclave</RimWorldAccess.Prisoner.Info.HeaderSlave>

  <!-- Last recruitment attempt breakdown. -->

  <!-- Slave stats block. -->
  <RimWorldAccess.Prisoner.Slave.Suppression>Répression : {0}</RimWorldAccess.Prisoner.Slave.Suppression>

  <!-- Release relation gain summary (shared between prisoner and slave paths).
       {0} = faction name, {1} = signed goodwill change (e.g. "+3" / "-7"),
       {2} = mental state inspect line. -->

  <!-- Medical care category labels. Used in the care-level stepper. -->
  <!-- Standalone hint appended to a section announcement when entering the medical care row. -->

  <!-- Interaction mode descriptions - warning suffixes appended after the
       def's own description through AnnouncementBuilder. {0} = ideo name. -->

  <!-- Slave emancipation outcome suffixes. {0} = slave faction name. -->

  <!-- Tab open / close announcements. -->
  <RimWorldAccess.Prisoner.Tab.Closed>Onglet Prisonnier fermé</RimWorldAccess.Prisoner.Tab.Closed>
  <RimWorldAccess.Prisoner.Tab.OpenedPrisoner>Onglet Prisonnier : {0}</RimWorldAccess.Prisoner.Tab.OpenedPrisoner>
  <RimWorldAccess.Prisoner.Tab.OpenedSlave>Onglet Esclave : {0}</RimWorldAccess.Prisoner.Tab.OpenedSlave>
  <RimWorldAccess.Prisoner.Tab.CurrentMode>Mode actuel : {0}</RimWorldAccess.Prisoner.Tab.CurrentMode>
  <!-- Embedded in a larger announcement sentence. -->
  <RimWorldAccess.Prisoner.Tab.NavigationHintInline>Appuyez sur Gauche/Droite pour naviguer entre les sections, Haut/Bas à l'intérieur d'une section, Entrée pour sélectionner</RimWorldAccess.Prisoner.Tab.NavigationHintInline>

  <!-- Section announcements. {0} = count (or current mode label). -->
  <RimWorldAccess.Prisoner.Section.Information>Section d'informations</RimWorldAccess.Prisoner.Section.Information>
  <RimWorldAccess.Prisoner.Section.ExclusiveModes>Modes d'interaction - {0} disponibles. Actuellement : {1}</RimWorldAccess.Prisoner.Section.ExclusiveModes>
  <RimWorldAccess.Prisoner.Section.MedicalCare>{0} - {1} disponibles</RimWorldAccess.Prisoner.Section.MedicalCare>
  <RimWorldAccess.Prisoner.Section.SlaveModes>Modes d'esclave - {0} disponibles. Actuellement : {1}</RimWorldAccess.Prisoner.Section.SlaveModes>
  <RimWorldAccess.Prisoner.Section.NonExclusiveModes>Modes non exclusifs - {0} disponibles. Appuyez sur Espace pour activer ou désactiver</RimWorldAccess.Prisoner.Section.NonExclusiveModes>
  <RimWorldAccess.Prisoner.Section.IdeologySelection>Sélection de l'idéoligion - Choisissez la cible de conversion</RimWorldAccess.Prisoner.Section.IdeologySelection>

  <!-- Item-level announcements and selection/toggle feedback used to be composed
       here by hand. The prisoner tab is now a ScreenScope whose rows carry a role
       and a state, so the shared element vocabulary
       (RimWorldAccess.Shell.Role.* / RimWorldAccess.Shell.State.*) speaks the
       selected marker, the on/off state and the toggle result instead. The keys
       Item.StateOn, Item.StateOff, Item.NonExclusiveMode, Item.SelectedSuffix,
       Action.Selected, Action.ToggleEnabled, Action.ToggleDisabled and
       Action.ToggleMode were removed with that change (element-uniformity
       campaign, task 8 packet C). -->
</LanguageData>
