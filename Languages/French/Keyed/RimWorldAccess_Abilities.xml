       AbilityTargetingHelper.BuildTargetingStartAnnouncement. {0} = ability
       label; other placeholders are inserted as their own fragments so that
       the sentence reads naturally even when some pieces are omitted. -->
  <RimWorldAccess.Abilities.Start.Fallback>Ciblage de capacité</RimWorldAccess.Abilities.Start.Fallback>
  <RimWorldAccess.Abilities.Start.Header>Ciblage : {0}</RimWorldAccess.Abilities.Start.Header>
  <RimWorldAccess.Abilities.Start.TouchRange>. Portée de contact</RimWorldAccess.Abilities.Start.TouchRange>
  <RimWorldAccess.Abilities.Start.Range>. Portée : {0} cases</RimWorldAccess.Abilities.Start.Range>
  <RimWorldAccess.Abilities.Start.AOE>, rayon de la zone d'effet : {0} cases</RimWorldAccess.Abilities.Start.AOE>
  <RimWorldAccess.Abilities.Start.Psyfocus>. Concentration psychique : {0}</RimWorldAccess.Abilities.Start.Psyfocus>
  <RimWorldAccess.Abilities.Start.NeuralHeat>, échauffement neuronal : {0}</RimWorldAccess.Abilities.Start.NeuralHeat>
  <RimWorldAccess.Abilities.Start.HintAoe>. Appuyez sur R pour vérifier la distance et la ligne de vue, T pour voir les cibles affectées.</RimWorldAccess.Abilities.Start.HintAoe>
  <RimWorldAccess.Abilities.Start.HintSingle>. Appuyez sur R pour vérifier la distance et la ligne de vue.</RimWorldAccess.Abilities.Start.HintSingle>

  <!-- Range/LOS/target feedback built by AbilityTargetingHelper.
       BuildRangeInfoAnnouncement. {0} = distance; {1} = max range.
       InRange/OutOfRange forms are dedicated so translators can reorder
       subject, distance, and verdict freely; NoTargetAtCursor takes the
       target-kind word as {0}. -->
  <RimWorldAccess.Abilities.Range.NoAbilityActive>Aucune capacité active</RimWorldAccess.Abilities.Range.NoAbilityActive>
  <RimWorldAccess.Abilities.Range.Distance>Distance : {0} cases</RimWorldAccess.Abilities.Range.Distance>
  <RimWorldAccess.Abilities.Range.InRange>, À PORTÉE</RimWorldAccess.Abilities.Range.InRange>
  <RimWorldAccess.Abilities.Range.OutOfRange>, HORS DE PORTÉE (max {0})</RimWorldAccess.Abilities.Range.OutOfRange>
  <RimWorldAccess.Abilities.Range.InRangeTouch>, À PORTÉE (contact)</RimWorldAccess.Abilities.Range.InRangeTouch>
  <RimWorldAccess.Abilities.Range.MustBeAdjacent>, doit être adjacent (portée de contact)</RimWorldAccess.Abilities.Range.MustBeAdjacent>
  <RimWorldAccess.Abilities.Range.NoLineOfSight>, AUCUNE LIGNE DE VUE</RimWorldAccess.Abilities.Range.NoLineOfSight>
