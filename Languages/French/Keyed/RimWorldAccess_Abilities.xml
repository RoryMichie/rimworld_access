<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Abilities module strings (src/Abilities/). Six files contribute:
      - AbilityTargetingHelper.cs  (helpers that build most announcement text)
      - AbilityTargetingPatch.cs   (Harmony hooks on Targeter.BeginTargeting)
      - AbilityTargetingState.cs   (psycast/ability map targeting)
      - JumpTargetingState.cs      (Jump Pack / Locust Armor jumping)
      - ItemTargetingState.cs      (CompTargetable/CompUsable items)
      - WorldAbilityTargetingState.cs (Farskip etc.)

    The targeting validation errors (out-of-range, line-of-sight, not-a-valid-
    target) are produced here and then spoken by src/Combat/TargetingPatch.cs;
    a handful of shared phrases (Out of range, Targeting: {0}, Invalid cursor
    position, No valid tile selected, World navigation not active) are pulled
    from RimWorldAccess_Common.xml and RimWorldAccess_Combat.xml instead of
    being re-declared.

    Placeholders follow string.Format. Whole-phrase keys are preferred for any
    composite sentence whose wording or word order should be free to vary by
    language. One/Many splits are only used where English agreement actually
    differs; single-form keys rely on each language's LanguageWorker.
  -->

  <!-- Fallback labels used when the specific target/equipment/ability can't
       be named. Spoken inline inside larger sentences, so keep them lowercase
       like the nouns they substitute for ("Jumping to ground", not "Jumping
       to Ground"). -->
  <RimWorldAccess.Abilities.Label.Unknown>inconnu</RimWorldAccess.Abilities.Label.Unknown>
  <RimWorldAccess.Abilities.Label.Invalid>invalide</RimWorldAccess.Abilities.Label.Invalid>
  <RimWorldAccess.Abilities.Label.Location>emplacement</RimWorldAccess.Abilities.Label.Location>
  <RimWorldAccess.Abilities.Label.Ground>sol</RimWorldAccess.Abilities.Label.Ground>
  <RimWorldAccess.Abilities.Label.Target>cible</RimWorldAccess.Abilities.Label.Target>
  <RimWorldAccess.Abilities.Label.Item>objet</RimWorldAccess.Abilities.Label.Item>
  <RimWorldAccess.Abilities.Label.Permit>permis</RimWorldAccess.Abilities.Label.Permit>
  <RimWorldAccess.Abilities.Label.Jump>Saut</RimWorldAccess.Abilities.Label.Jump>

  <!-- Target-requirement phrases, substituted into "No {requirement} at
       cursor" and similar sentences. The trailing "valid target" form is the
       fallback; translators may want distinct words depending on context. -->
  <RimWorldAccess.Abilities.TargetKind.Unknown>inconnu</RimWorldAccess.Abilities.TargetKind.Unknown>
  <RimWorldAccess.Abilities.TargetKind.LocationOrPawn>emplacement ou personnage</RimWorldAccess.Abilities.TargetKind.LocationOrPawn>
  <RimWorldAccess.Abilities.TargetKind.Pawn>personnage</RimWorldAccess.Abilities.TargetKind.Pawn>
  <RimWorldAccess.Abilities.TargetKind.HumanlikePawn>personnage humain</RimWorldAccess.Abilities.TargetKind.HumanlikePawn>
  <RimWorldAccess.Abilities.TargetKind.Animal>animal</RimWorldAccess.Abilities.TargetKind.Animal>
  <RimWorldAccess.Abilities.TargetKind.BuildingOrStructure>bâtiment ou structure</RimWorldAccess.Abilities.TargetKind.BuildingOrStructure>
  <RimWorldAccess.Abilities.TargetKind.ValidTarget>cible valide</RimWorldAccess.Abilities.TargetKind.ValidTarget>

