<LanguageData>
  <!--
    Narrative Feed (speech mods campaign, src/Narrative/NarrativeFeed.Game.cs).
    Grammar keys compose one spoken line of ambient dialogue/narration; the
    caller picks the variant based on which of speaker/recipient resolved.
    {0}/{1}/{2} are already-resolved passthrough strings (pawn LabelShort,
    line text) via .Translate(args), not authored prose fragments.
  -->
  <RimWorldAccess.Narrative.LineTo>{0} to {1}: {2}</RimWorldAccess.Narrative.LineTo>
  <RimWorldAccess.Narrative.Line>{0}: {1}</RimWorldAccess.Narrative.Line>
  <RimWorldAccess.Narrative.System>{0}</RimWorldAccess.Narrative.System>

  <!--
    The stable-read rule's shared marker (speech mods campaign S15, src/Narrative/AsyncTextStability.Game.cs).
    Spoken INSTEAD OF any in-flight streamed/generated text while an extension mod's async
    rewrite is still running, never a fragment of the real text. See Literature's book/art
    inspection-tree children (S15) and S16 Quests for riders.
  -->
  <RimWorldAccess.Narrative.StillBeingWritten>Still being written.</RimWorldAccess.Narrative.StillBeingWritten>

  <!-- Settings (Main Menu > Options > RimWorld Access), src/Shell/Screens/OptionsRwaCategory.Game.cs. -->
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>Announce generated pawn dialogue</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>Speaks dialogue lines written by story mods such as RimTalk.</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>Announce vanilla interaction bubbles</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>Speaks the game's own social chitchat lines. Requires the Interaction Bubbles mod by Jaxe.</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>Announce dialogue even when RimTalk TTS is speaking it</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>When off, the screen reader stays silent for a line while RimTalk's TTS addon voices it aloud; the Dialogue Log still records it.</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>

