<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Configure Spoken Announcements screen (src/Shell/Screens/AnnouncementConfigDialog.Game.cs
    — Dialog_ConfigureAnnouncements / AnnouncementConfigScope). Opened from a button in both
    RimWorld Access settings surfaces (see RimWorldAccess_Core.xml's
    RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button).

    The seven part names/examples cover the seven parts the screen lists; the example
    fragments show a translator exactly what that part sounds like in an announcement so they
    can adapt the sample text to their own language's phrasing.
  -->

  <RimWorldAccess.AnnounceConfig.Title>Configure spoken announcements</RimWorldAccess.AnnounceConfig.Title>
  <RimWorldAccess.AnnounceConfig.Intro>Choose which parts of an announcement are spoken and the order they play in. Changes take effect immediately, so you can hear the result while you browse this list. Press Space or Enter to toggle a part, and press Ctrl with the Up and Down arrows to move it.</RimWorldAccess.AnnounceConfig.Intro>
  <RimWorldAccess.AnnounceConfig.PartsRegion>Announcement parts</RimWorldAccess.AnnounceConfig.PartsRegion>

  <!-- The Name part's row is always drawn checked and disabled; see
       RimWorldAccess.AnnounceConfig.NameAlwaysOn below. -->
  <RimWorldAccess.AnnounceConfig.Part.Label>Name</RimWorldAccess.AnnounceConfig.Part.Label>
  <RimWorldAccess.AnnounceConfig.Part.Hotkey>Keyboard shortcut</RimWorldAccess.AnnounceConfig.Part.Hotkey>
  <RimWorldAccess.AnnounceConfig.Part.RoleAndState>Control type and state</RimWorldAccess.AnnounceConfig.Part.RoleAndState>
  <RimWorldAccess.AnnounceConfig.Part.Level>Tree level</RimWorldAccess.AnnounceConfig.Part.Level>
  <RimWorldAccess.AnnounceConfig.Part.Position>Position in list</RimWorldAccess.AnnounceConfig.Part.Position>
  <RimWorldAccess.AnnounceConfig.Part.Extras>Description and details</RimWorldAccess.AnnounceConfig.Part.Extras>
  <RimWorldAccess.AnnounceConfig.Part.Hint>Interaction hints</RimWorldAccess.AnnounceConfig.Part.Hint>

  <RimWorldAccess.AnnounceConfig.Example.Label>for example: Allow fresh corpses</RimWorldAccess.AnnounceConfig.Example.Label>
  <RimWorldAccess.AnnounceConfig.Example.Hotkey>for example: Alt+C</RimWorldAccess.AnnounceConfig.Example.Hotkey>
  <RimWorldAccess.AnnounceConfig.Example.RoleAndState>for example: checkbox, checked</RimWorldAccess.AnnounceConfig.Example.RoleAndState>
  <RimWorldAccess.AnnounceConfig.Example.Level>for example: level 2</RimWorldAccess.AnnounceConfig.Example.Level>
  <RimWorldAccess.AnnounceConfig.Example.Position>for example: 4 of 13</RimWorldAccess.AnnounceConfig.Example.Position>
  <RimWorldAccess.AnnounceConfig.Example.Extras>for example: Includes rotten ones</RimWorldAccess.AnnounceConfig.Example.Extras>
  <RimWorldAccess.AnnounceConfig.Example.Hint>for example: Press Enter to select</RimWorldAccess.AnnounceConfig.Example.Hint>

  <!-- Spoken (as Extras, after the example fragment) and appended in place of the toggle
       when the player tries to act on the Name part's row; it can be reordered but never
       turned off, since silencing it would leave the player unable to tell what is focused. -->
  <RimWorldAccess.AnnounceConfig.NameAlwaysOn>The item's name is always spoken.</RimWorldAccess.AnnounceConfig.NameAlwaysOn>

  <!-- Standalone verbosity toggles listed after the reorderable parts. Not parts
       of the focus announcement, so they toggle but never reorder. -->
  <RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition>Row and column positions in tables</RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition>
  <RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition.Example>for example: row 3 of 8, column 2 of 5</RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition.Example>
  <RimWorldAccess.AnnounceConfig.Extra.TableDimensions>Table size when entering a table</RimWorldAccess.AnnounceConfig.Extra.TableDimensions>
  <RimWorldAccess.AnnounceConfig.Extra.TableDimensions.Example>for example: table, 5 columns, 8 rows</RimWorldAccess.AnnounceConfig.Extra.TableDimensions.Example>
  <RimWorldAccess.AnnounceConfig.Extra.SectionCount>How many sections a screen has, and which one you are in</RimWorldAccess.AnnounceConfig.Extra.SectionCount>
  <RimWorldAccess.AnnounceConfig.Extra.SectionCount.Example>for example: 2 sections, or section 2 of 3</RimWorldAccess.AnnounceConfig.Extra.SectionCount.Example>

  <!-- The Preview button's canned demo item, composed live through the same ComposeFocus
       path as every real announcement, so it always reflects the current working toggles/order. -->
  <RimWorldAccess.AnnounceConfig.Preview.Button>Preview announcement</RimWorldAccess.AnnounceConfig.Preview.Button>
  <RimWorldAccess.AnnounceConfig.Preview.Label>Example item</RimWorldAccess.AnnounceConfig.Preview.Label>
  <RimWorldAccess.AnnounceConfig.Preview.Hotkey>Alt+P</RimWorldAccess.AnnounceConfig.Preview.Hotkey>
  <RimWorldAccess.AnnounceConfig.Preview.Extras>This is an example description showing the kind of detail an item's own text provides.</RimWorldAccess.AnnounceConfig.Preview.Extras>
  <RimWorldAccess.AnnounceConfig.Preview.Hint>Press Enter to select.</RimWorldAccess.AnnounceConfig.Preview.Hint>

  <!-- Spoken once when the Restore defaults button or its chord runs. The button's own caption
       reuses Core's RestoreToDefaultSettings, the same way Save and Cancel reuse Core's. -->
  <RimWorldAccess.AnnounceConfig.ResetToDefaults.Done>Announcement settings restored to defaults.</RimWorldAccess.AnnounceConfig.ResetToDefaults.Done>
</LanguageData>
