<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    QA flight recorder (src/Shell/Compat/FlightRecorder.Game.cs). Alt (Option on macOS) plus
    the vanilla screenshot key starts and stops a recording anywhere; stopping opens
    Dialog_RecordingSaved with the saved path unless suppressed. The two Settings keys are the
    suppression toggle's row in both RimWorld Access settings surfaces.
  -->
  <RimWorldAccess.FlightRecorder.Started>Flight recorder started.</RimWorldAccess.FlightRecorder.Started>
  <RimWorldAccess.FlightRecorder.Stopped>Flight recorder stopped.</RimWorldAccess.FlightRecorder.Stopped>
  <RimWorldAccess.FlightRecorder.StoppedWithPath>Flight recorder stopped. Recording saved to {0}.</RimWorldAccess.FlightRecorder.StoppedWithPath>
  <RimWorldAccess.FlightRecorder.Marker>Marker {0} recorded.</RimWorldAccess.FlightRecorder.Marker>
  <RimWorldAccess.FlightRecorder.DialogTitle>Recording saved</RimWorldAccess.FlightRecorder.DialogTitle>
  <RimWorldAccess.FlightRecorder.DialogBody>The flight recorder log was saved to: {0}</RimWorldAccess.FlightRecorder.DialogBody>
  <RimWorldAccess.FlightRecorder.DontShowAgain>Do not show this dialog again</RimWorldAccess.FlightRecorder.DontShowAgain>
  <RimWorldAccess.FlightRecorder.OpenFolder>Open folder</RimWorldAccess.FlightRecorder.OpenFolder>
  <RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Label>Show a dialog when a flight recording is saved</RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Label>
  <RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Desc>When a flight recorder session stops ({0}), open a dialog with the saved file's location. When off, the location is spoken instead.</RimWorldAccess.Core.Settings.ShowRecordingSavedDialog.Desc>
</LanguageData>
