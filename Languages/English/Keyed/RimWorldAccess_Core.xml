<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Core module strings (src/Core/). Five files contribute, but most produce
    no player-facing output:

      - rimworld_access.cs          (entry point — Log.* only, intentionally English)
      - GameStartPatch.cs           (no user-facing strings)
      - ModLogger.cs                (logging helper — intentionally English)
      - ReloadHelper.cs             (#if DEBUG hot-reload — dev-only TolkHelper
                                     lines are intentionally English)
      - RimWorldAccessSettings.cs   (the Mod Settings panel — THIS file's scope)

    Intentionally left in English per docs/decisions.md Decision 5:
      * Every Log.Message / Log.Warning / Log.Error in rimworld_access.cs
        ("Initializing accessibility features...", "Applying Harmony patches...",
        "Total patches applied: {count}", "Main menu keyboard navigation
        enabled!", "Use Arrow keys to navigate, Enter to select.",
        "Tearing down for reload...", "Shutting down...", etc.) — these go to
        RimWorld's debug console for bug triage, not to players.
      * ModLogger prefix "[RimWorld Access] " — log decoration.
      * ReloadHelper.cs TolkHelper.Speak announcements ("Reloading RimWorld
        Access", "RimWorld Access reloaded", "Reload failed: ...") — the
        entire file is wrapped in #if DEBUG and only fires in the developer
        hot-reload path, never in a shipped player build.
      * "[RimWorld Access] Settings loaded." Log.Message in the Mod ctor.

    The keys below cover the only truly player-facing surface in this
    module: the Options > Mod Settings panel for RimWorld Access.
  -->

  <!-- Settings panel category name (RimWorldAccessMod_Settings.SettingsCategory).
       Shown as the row label in Options > Mod Settings. Translators may keep
       "RimWorld Access" verbatim (brand name) or transliterate/adjust
       capitalization for their locale. -->
  <RimWorldAccess.Core.Settings.Category>RimWorld Access</RimWorldAccess.Core.Settings.Category>

  <!-- Checkbox labels in DoSettingsWindowContents, top-to-bottom order.
       Each one toggles a single RimWorldAccessSettings bool. -->
  <RimWorldAccess.Core.Settings.WrapNavigation.Label>Wrap navigation</RimWorldAccess.Core.Settings.WrapNavigation.Label>
  <RimWorldAccess.Core.Settings.ShowPawnActivityOnMap.Label>Show pawn activity on map cursor movement</RimWorldAccess.Core.Settings.ShowPawnActivityOnMap.Label>
  <RimWorldAccess.Core.Settings.ShowCoverInfo.Label>Show cover info for drafted and hostile pawns</RimWorldAccess.Core.Settings.ShowCoverInfo.Label>
  <RimWorldAccess.Core.Settings.AnnounceTerrain.Label>Announce terrain on cursor movement</RimWorldAccess.Core.Settings.AnnounceTerrain.Label>
  <RimWorldAccess.Core.Settings.HoverSpeech.Label>Mouse tracking</RimWorldAccess.Core.Settings.HoverSpeech.Label>
  <RimWorldAccess.Core.Settings.HoverSpeech.Desc>Announces what the mouse is over as you move it.</RimWorldAccess.Core.Settings.HoverSpeech.Desc>
  <RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Label>Mouse pointer follows the keyboard cursor</RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Label>
  <RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Desc>Places the mouse pointer on the keyboard cursor's tile after every move. {0} to adjust in game.</RimWorldAccess.Core.Settings.PointerFollowsKeyboard.Desc>
  <RimWorldAccess.Core.Settings.ScannerAutoJump.Label>Scanner auto-jump</RimWorldAccess.Core.Settings.ScannerAutoJump.Label>
  <RimWorldAccess.Core.Settings.ScannerAutoJump.Desc>Moves the cursor to each scanner item as you navigate. {0} to adjust in game.</RimWorldAccess.Core.Settings.ScannerAutoJump.Desc>
  <RimWorldAccess.Core.Settings.PauseOnGameStart.Label>Start new games paused</RimWorldAccess.Core.Settings.PauseOnGameStart.Label>
  <RimWorldAccess.Core.Settings.PauseOnGameStart.Desc>A new game begins paused so you can get your bearings before time starts.</RimWorldAccess.Core.Settings.PauseOnGameStart.Desc>
  <RimWorldAccess.Core.Settings.StayPausedAfterResearch.Label>Stay paused on the research screen</RimWorldAccess.Core.Settings.StayPausedAfterResearch.Label>
  <RimWorldAccess.Core.Settings.StayPausedAfterResearch.Desc>Opening the research screen from a completed-research dialog keeps the game paused.</RimWorldAccess.Core.Settings.StayPausedAfterResearch.Desc>
  <RimWorldAccess.Core.Settings.StayPausedAfterTrade.Label>Stay paused after trading</RimWorldAccess.Core.Settings.StayPausedAfterTrade.Label>
  <RimWorldAccess.Core.Settings.StayPausedAfterTrade.Desc>Closing the trade screen keeps the game paused until you resume.</RimWorldAccess.Core.Settings.StayPausedAfterTrade.Desc>

  <!-- Opens the Configure Spoken Announcements screen (a real window, not this panel);
       see RimWorldAccess_AnnounceConfig.xml for that screen's own strings. -->
  <RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button>Configure spoken announcements...</RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button>

  <!-- SubmenuTreeNavigation is the only checkbox with a tooltip. The label is
       deliberately whimsical ("Rashad Hates Treeviews") — translators can
       preserve the joke or replace it with something equivalent in their
       culture as long as it still telegraphs what the setting does. The
       tooltip is the canonical explanation. -->
  <RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Label>Rashad Hates Treeviews (submenu-style navigation)</RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Label>
  <RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Tooltip>Changes how treeviews work. When you expand a category, it disappears and you navigate only its items. Press Left Arrow to go back. Your position is remembered when you return.</RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Tooltip>

  <!-- Selected-pawn activity. The cursor-move clause in the Desc is the escape
       hatch, so keep it if this is ever shortened. -->
  <RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Label>Announce selected pawn activity</RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Label>
  <RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Desc>Announces what the selected pawn is doing in real time. Moving the map cursor stops the announcements.</RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Desc>

  <RimWorldAccess.Core.Settings.ShowWhatsNew.Label>Show What's New message after an update</RimWorldAccess.Core.Settings.ShowWhatsNew.Label>
  <RimWorldAccess.Core.Settings.ShowWhatsNew.Desc>When on, the What's New message opens on the main menu after RimWorld Access updates. When off, you hear only a brief notice that the mod updated, and can open What's New from the menu whenever you like.</RimWorldAccess.Core.Settings.ShowWhatsNew.Desc>
</LanguageData>
