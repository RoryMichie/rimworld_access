<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    New keys added by the migration of the What's New reader
    (WhatsNewState/WhatsNewScope) and the Learning Helper (LearningHelperState/
    LearningHelperScope) onto ScreenScope. Every other player-facing string
    these two screens use is unchanged and still lives in
    RimWorldAccess_WhatsNew.xml / RimWorldAccess_Learning.xml.
  -->

  <!-- What's New: the migrated content region's name. -->
  <RimWorldAccess.OverlayMigration.WhatsNew.RegionName>公告</RimWorldAccess.OverlayMigration.WhatsNew.RegionName>

  <!-- Learning Helper: the two migrated content regions' names. -->
  <RimWorldAccess.OverlayMigration.Learning.LessonsRegionName>教程</RimWorldAccess.OverlayMigration.Learning.LessonsRegionName>
  <RimWorldAccess.OverlayMigration.Learning.ContentRegionName>教程内容</RimWorldAccess.OverlayMigration.Learning.ContentRegionName>

  <!-- The Lessons region's mode row (a ComboBox; Left/Right cycles it) — replaces the retired
       Tab toggle. ModeActive/ModeAll are also spoken as the mode-change announcement when lessons
       remain in the new mode; ModeAllCount is the count-aware variant for All lessons ({0} = total). -->
  <RimWorldAccess.OverlayMigration.Learning.ModeLabel>教程列表模式</RimWorldAccess.OverlayMigration.Learning.ModeLabel>
  <RimWorldAccess.OverlayMigration.Learning.ModeActive>当前教程</RimWorldAccess.OverlayMigration.Learning.ModeActive>
  <RimWorldAccess.OverlayMigration.Learning.ModeAll>全部教程</RimWorldAccess.OverlayMigration.Learning.ModeAll>
  <RimWorldAccess.OverlayMigration.Learning.ModeAllCount>全部教程，共 {0} 个</RimWorldAccess.OverlayMigration.Learning.ModeAllCount>

  <!-- Replace RimWorldAccess.Learning.NoActive / .NoActiveRemaining / .OpeningNoActive (ORPHANED
       by this migration): those said "Press Tab to browse all lessons", which is no longer true
       now that Tab cycles regions and the mode row (Left/Right) switches modes instead. -->
  <RimWorldAccess.OverlayMigration.Learning.NoActiveShort>没有可用的当前教程。</RimWorldAccess.OverlayMigration.Learning.NoActiveShort>
  <RimWorldAccess.OverlayMigration.Learning.NoActiveRemainingShort>没有剩余的当前教程。</RimWorldAccess.OverlayMigration.Learning.NoActiveRemainingShort>
  <RimWorldAccess.OverlayMigration.Learning.OpeningNoActive>没有当前教程。将模式行切换为全部教程以浏览全部内容。</RimWorldAccess.OverlayMigration.Learning.OpeningNoActive>
</LanguageData>
