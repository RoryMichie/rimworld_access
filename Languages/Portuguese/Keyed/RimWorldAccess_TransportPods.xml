  <RimWorldAccess.TransportPods.Selection.NoPodSelected>Nenhuma cápsula seleccionada</RimWorldAccess.TransportPods.Selection.NoPodSelected>

  <!-- Entry announcement (Open). {0} = number of pods that can be grouped
       (source pod + reachable launchers via flood fill). -->
  <RimWorldAccess.TransportPods.Selection.EnterMode>Modo de selecção de cápsulas. {0} cápsulas podem ser agrupadas. Usa as setas para ires até às cápsulas, Espaço para seleccionar, Enter para carregar.</RimWorldAccess.TransportPods.Selection.EnterMode>

  <!-- Cancellation (Close). -->
  <RimWorldAccess.TransportPods.Selection.Cancelled>Selecção de cápsulas cancelada</RimWorldAccess.TransportPods.Selection.Cancelled>

  <!-- Per-toggle feedback (TogglePodAtCursor). {0} = current selected count. -->
  <RimWorldAccess.TransportPods.Selection.NoPodHere>Nenhuma cápsula de transporte aqui</RimWorldAccess.TransportPods.Selection.NoPodHere>
  <RimWorldAccess.TransportPods.Selection.NotAdjacent>O lançador desta cápsula não está adjacente ao grupo.</RimWorldAccess.TransportPods.Selection.NotAdjacent>
  <RimWorldAccess.TransportPods.Selection.AlreadyLoading>A cápsula já está a carregar ou pronta para lançamento</RimWorldAccess.TransportPods.Selection.AlreadyLoading>
  <RimWorldAccess.TransportPods.Selection.PodSelected>Cápsula seleccionada. {0} seleccionadas</RimWorldAccess.TransportPods.Selection.PodSelected>
  <RimWorldAccess.TransportPods.Selection.PodDeselected>Cápsula removida da selecção. {0} seleccionadas</RimWorldAccess.TransportPods.Selection.PodDeselected>

  <!-- Confirmation errors (ConfirmSelection). -->
  <RimWorldAccess.TransportPods.Selection.NoPodsSelected>Nenhuma cápsula seleccionada. Usa as setas para ires até às cápsulas e pressiona Espaço para seleccionares.</RimWorldAccess.TransportPods.Selection.NoPodsSelected>
  <RimWorldAccess.TransportPods.Selection.PodsUnavailable>As cápsulas seleccionadas já não estão disponíveis</RimWorldAccess.TransportPods.Selection.PodsUnavailable>
  <RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>Não foi possível encontrar o comando de carregamento. A cápsula pode já estar a carregar.</RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>

  <!-- =========================================================
       TransportPodLoadingState.cs - Dialog_LoadTransporters keyboard nav.
       ========================================================= -->

  <!-- Open guards. -->
  <RimWorldAccess.TransportPods.Loading.ReflectionFailed>Acessibilidade do carregamento de cápsulas de transporte indisponível devido a uma actualização do jogo. Verifica se há actualizações do mod.</RimWorldAccess.TransportPods.Loading.ReflectionFailed>

  <!-- Entry announcement. One/Many split so translators control pod/pods
       agreement; the pod-noun key is inlined into the sentence so word order
       stays natural across languages.
       {0} = pod count, {1} = total mass capacity. -->
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>Carregar cápsula de transporte. {0} cápsula, capacidade de {1} kg. Esquerda/Direita para as abas, Enter para ajustar.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>Carregar cápsulas de transporte. {0} cápsulas, capacidade de {1} kg. Esquerda/Direita para as abas, Enter para ajustar.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>

  <!-- Tab navigation. -->

  <!-- Shared empty-tab feedback (spoken in multiple navigation paths). -->

  <!-- Activation and quantity actions. {0} = item label. -->
  <RimWorldAccess.TransportPods.Loading.ItemChecked>{0} marcado</RimWorldAccess.TransportPods.Loading.ItemChecked>
  <RimWorldAccess.TransportPods.Loading.ItemUnchecked>{0} não marcado</RimWorldAccess.TransportPods.Loading.ItemUnchecked>
  <RimWorldAccess.TransportPods.Loading.ItemRemoved>{0} removido</RimWorldAccess.TransportPods.Loading.ItemRemoved>

  <!-- Inspect results. -->
  <RimWorldAccess.TransportPods.Loading.NoItemToInspect>Nenhum item para inspeccionar</RimWorldAccess.TransportPods.Loading.NoItemToInspect>

  <!-- Delete/remove guard. -->
  <RimWorldAccess.TransportPods.Loading.AlreadyAtZero>Já em zero</RimWorldAccess.TransportPods.Loading.AlreadyAtZero>

  <!-- Reset (Alt+R). -->
  <RimWorldAccess.TransportPods.Loading.ResetAll>Todos os itens redefinidos para zero</RimWorldAccess.TransportPods.Loading.ResetAll>

  <!-- Mass summary (Tab key / AnnounceMassSummary).
       Composed from MassLine + one of OverloadedStatus/RemainingStatus.
       {0} = current usage, {1} = capacity, {2} = status clause. -->

  <!-- Summary view (Tab toggle). Empty/error states come next. -->
  <RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>Nenhum transporte</RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>
  <RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>Estatísticas indisponíveis</RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>

  <!-- Summary item format ({item}. {position}). {0} = stat line, {1} = position. -->

  <!-- Stat-breakdown view (Alt+I in summary mode). NoBreakdown is spoken when
       the selected stat has no cached explanation (e.g. Food).
       Stat names (spoken as the breakdown window title). -->
  <RimWorldAccess.TransportPods.Loading.NoBreakdown>Nenhum detalhe disponível para este item</RimWorldAccess.TransportPods.Loading.NoBreakdown>
  <RimWorldAccess.TransportPods.Loading.StatMassCapacity>Capacidade de Massa</RimWorldAccess.TransportPods.Loading.StatMassCapacity>
  <RimWorldAccess.TransportPods.Loading.StatSpeed>Velocidade</RimWorldAccess.TransportPods.Loading.StatSpeed>
  <RimWorldAccess.TransportPods.Loading.StatForaging>Foragibilidade</RimWorldAccess.TransportPods.Loading.StatForaging>
  <RimWorldAccess.TransportPods.Loading.StatVisibility>Visibilidade</RimWorldAccess.TransportPods.Loading.StatVisibility>

