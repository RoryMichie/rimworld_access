  <RimWorldAccess.TransportPods.Portal.Cancelled>{0} cancelado</RimWorldAccess.TransportPods.Portal.Cancelled>
  <RimWorldAccess.TransportPods.Portal.FallbackEnter>Carregar portal</RimWorldAccess.TransportPods.Portal.FallbackEnter>
  <RimWorldAccess.TransportPods.Portal.FallbackLoading>A carregar</RimWorldAccess.TransportPods.Portal.FallbackLoading>
  <!-- Localization guardrail (D.8) sweep — previously hardcoded English. -->

  <!-- Region name for the stats section (screen-model refactor: the old
       Tab-key Summary view is now a region cycled with Tab/Shift+Tab). -->
  <RimWorldAccess.TransportPods.Loading.SummaryTab>Resumo</RimWorldAccess.TransportPods.Loading.SummaryTab>
</LanguageData>
