<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Narrative Feed (speech mods campaign, src/Narrative/NarrativeFeed.Game.cs).
    Grammar keys compose one spoken line of ambient dialogue/narration; the
    caller picks the variant based on which of speaker/recipient resolved.
    {0}/{1}/{2} are already-resolved passthrough strings (pawn LabelShort,
    line text) via .Translate(args), not authored prose fragments.
  -->
  <RimWorldAccess.Narrative.LineTo>{0} para {1}: {2}</RimWorldAccess.Narrative.LineTo>
  <RimWorldAccess.Narrative.Line>{0}: {1}</RimWorldAccess.Narrative.Line>
  <RimWorldAccess.Narrative.System>{0}</RimWorldAccess.Narrative.System>

  <!--
    The stable-read rule's shared marker (speech mods campaign S15, src/Narrative/AsyncTextStability.Game.cs).
    Spoken INSTEAD OF any in-flight streamed/generated text while an extension mod's async
    rewrite is still running, never a fragment of the real text. See Literature's book/art
    inspection-tree children (S15) and S16 Quests for riders.
  -->
  <RimWorldAccess.Narrative.StillBeingWritten>Ainda a ser escrito.</RimWorldAccess.Narrative.StillBeingWritten>

  <!-- Settings (Main Menu > Options > RimWorld Access), src/Shell/Screens/OptionsRwaCategory.Game.cs. -->
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>Anunciar os diálogos gerados dos colonos</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>Lê as falas escritas por mods narrativos como o RimTalk.</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>Anunciar balões de interacção padrão</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>Lê as conversas sociais do próprio jogo. Requer o mod Interaction Bubbles de Jaxe.</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>Anunciar diálogo mesmo quando o TTS do RimTalk já estiver a falar</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>Quando desactivado, o leitor de ecrã fica em silêncio durante uma linha enquanto o complemento de TTS do RimTalk a diz em voz alta; o Registo de Diálogo continua a registá-la.</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>

