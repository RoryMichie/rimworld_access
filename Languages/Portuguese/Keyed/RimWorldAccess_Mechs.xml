<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Mechs module strings (src/Mechs/). Two source files contribute:
      - MechsMenuState.cs   (mechanoid management tab navigation + paint)
      - MechsMenuHelper.cs  (cell value / column fallbacks)

    This tab is the Biotech mechanoid manager. Like the Animals and Wildlife
    tabs it is built on TabularMenuHelper<Pawn>, so its sort feedback, paint
    feedback, and submenu phrasing run parallel to the Animals module. The
    placeholder patterns mirror RimWorldAccess_Animals.xml deliberately so
    translators can keep the families consistent.

    Placeholders follow string.Format ({0}, {1}, ...). Game-supplied DATA is
    never translated here and is passed in as arguments instead:
      - mech names (pawn.LabelShort), area labels, work-mode LabelCaps,
        control-group indices, column header text, and the game's own draft
        reason text all come from RimWorld and stay in the player's language
        via the game's own translation system.

    Shared phrases delegated to RimWorldAccess_Common.xml (NOT redefined here):
      - position suffix ("{0} of {1}"), cannot-paint-column, edge announcements
      - typeahead search scaffolding, info-card-unavailable, jumped-to
    Vanilla keys reused directly in C# (NOT redefined here):
      - "Biotech", "Gestating", "None", "Unrestricted", "On", "Off",
        "ManageAreas", "Name", "AllowedArea", "CommandDraftLabel",
        "CommandUndraftLabel", and similar.
  -->

  <!-- =================================================================
       Shared cell fallbacks (MechsMenuHelper). "Unknown" is the out-of-range
       fallback; "N/A" is spoken for cells that don't apply to a given mech
       (e.g. no energy need, no repair comp, no control group). -->
  <RimWorldAccess.Mechs.Value.Unknown>Desconhecido</RimWorldAccess.Mechs.Value.Unknown>
  <RimWorldAccess.Mechs.Value.NotApplicable>N/A</RimWorldAccess.Mechs.Value.NotApplicable>

  <!-- Paint value labels for checkbox columns whose specific column has no
       dedicated wording (the Draft/AutoRepair columns supply their own via
       vanilla keys; this is the generic fallback). -->
  <RimWorldAccess.Mechs.Paint.Checked>marcado</RimWorldAccess.Mechs.Paint.Checked>
  <RimWorldAccess.Mechs.Paint.Unchecked>não marcado</RimWorldAccess.Mechs.Paint.Unchecked>

  <!-- =================================================================
       MechsMenuState lifecycle and navigation announcements.
       OpeningTitle: {0} = mech count. -->
  <RimWorldAccess.Mechs.Menu.BiotechRequired>Expansão Biotech necessária</RimWorldAccess.Mechs.Menu.BiotechRequired>
  <RimWorldAccess.Mechs.Menu.NoMechsFound>Nenhum mecanoide encontrado</RimWorldAccess.Mechs.Menu.NoMechsFound>
  <RimWorldAccess.Mechs.Menu.OpeningTitle>Menu de mecanoides, {0} mecanoides</RimWorldAccess.Mechs.Menu.OpeningTitle>
  <RimWorldAccess.Mechs.Menu.Closed>Menu de mecanoides fechado</RimWorldAccess.Mechs.Menu.Closed>
  <RimWorldAccess.Mechs.Menu.NoMechs>Nenhum mecanoide</RimWorldAccess.Mechs.Menu.NoMechs>
  <RimWorldAccess.Mechs.Menu.NotOnMap>Mecanoide fora do mapa</RimWorldAccess.Mechs.Menu.NotOnMap>

  <!-- =================================================================
       Draft column interaction (Enter on Draft cell). CannotDraft is the
       fallback spoken only when the game supplies no reason of its own;
       the game's own reason text is spoken verbatim when present. -->
  <RimWorldAccess.Mechs.Draft.CannotDraftThisMech>Impossível alistar este mecanoide</RimWorldAccess.Mechs.Draft.CannotDraftThisMech>
  <RimWorldAccess.Mechs.Draft.CannotDraft>Impossível alistar</RimWorldAccess.Mechs.Draft.CannotDraft>

  <!-- Auto-repair column interaction. -->
  <RimWorldAccess.Mechs.AutoRepair.NoComponent>Sem componente de auto-reparação</RimWorldAccess.Mechs.AutoRepair.NoComponent>

  <!-- =================================================================
       Submenu (Control Group / Work Mode / Allowed Area).
       Open-time errors first, then the option-row phrasing.
       CurrentMarker: {0} = the option label; marks the mech's current value.
       Option: {0} = option label, {1} = position suffix (typeahead variant).
       OptionAnnounce: {0} = option label, {1} = position suffix.
       OptionWithDesc: {0} = option label, {1} = work-mode description,
         {2} = position suffix. -->
  <RimWorldAccess.Mechs.Submenu.NoOverseer>Nenhum supervisor</RimWorldAccess.Mechs.Submenu.NoOverseer>
  <RimWorldAccess.Mechs.Submenu.NoControlGroup>Nenhum grupo de controlo</RimWorldAccess.Mechs.Submenu.NoControlGroup>
  <!-- Spoken instead of applying an allowed area when the mech fails
       vanilla's own compound gate (most commonly: no live overseer) —
       mirrors PawnColumnWorker_AllowedArea's DoCell, which draws no selector
       at all for such a mech. -->
  <RimWorldAccess.Mechs.Submenu.AreaNotAllowed>{0}: impossível atribuir área permitida</RimWorldAccess.Mechs.Submenu.AreaNotAllowed>
  <RimWorldAccess.Mechs.Submenu.CurrentMarker>{0} (actual)</RimWorldAccess.Mechs.Submenu.CurrentMarker>
  <RimWorldAccess.Mechs.Submenu.Option>{0}. {1}</RimWorldAccess.Mechs.Submenu.Option>
  <RimWorldAccess.Mechs.Submenu.OptionAnnounce>{0} ({1})</RimWorldAccess.Mechs.Submenu.OptionAnnounce>
  <RimWorldAccess.Mechs.Submenu.OptionWithDesc>{0}. {1} ({2})</RimWorldAccess.Mechs.Submenu.OptionWithDesc>

  <!-- Control-group submenu apply feedback. -->
  <RimWorldAccess.Mechs.ControlGroup.AlreadyInGroup>Já está neste grupo</RimWorldAccess.Mechs.ControlGroup.AlreadyInGroup>

  <!-- Work-mode submenu apply feedback. SetForGroup: {0} = work-mode label,
       {1} = control-group index. -->
  <RimWorldAccess.Mechs.WorkMode.AlreadySet>Já definido para este modo</RimWorldAccess.Mechs.WorkMode.AlreadySet>
  <RimWorldAccess.Mechs.WorkMode.SetForGroup>Modo de trabalho definido como {0} para o grupo de controlo {1}</RimWorldAccess.Mechs.WorkMode.SetForGroup>

  <!-- =================================================================
       Sort feedback (Alt+S). Mirrors the Animals sort vocabulary.
       CannotSort/SortedBy: {0} = column name, {1} = direction word.
       NowAt: {0} = the rebuilt cell announcement after a resort. -->
  <RimWorldAccess.Mechs.Sort.NowAt>Agora em {0}</RimWorldAccess.Mechs.Sort.NowAt>

  <!-- =================================================================
       Single-step paint (Shift+Down / Shift+Up).
       Allowed Area: {0} = mech name, {1} = area label, {2} = position. -->
  <RimWorldAccess.Mechs.Paint.Single.AreaAlreadySet>{0}: já definido como {1}. {2}</RimWorldAccess.Mechs.Paint.Single.AreaAlreadySet>
  <RimWorldAccess.Mechs.Paint.Single.AreaApplied>{0}: {1} aplicado. {2}</RimWorldAccess.Mechs.Paint.Single.AreaApplied>
  <!-- Spoken instead of AreaApplied when the target fails vanilla's own
       compound gate (see PawnColumnWorker_AllowedArea.DoCell — most commonly:
       no live overseer) — the write was correctly skipped, so this must not
       claim success. -->
  <RimWorldAccess.Mechs.Paint.Single.AreaNotAllowed>{0}: impossível atribuir área permitida. {1}</RimWorldAccess.Mechs.Paint.Single.AreaNotAllowed>

  <!-- Single-step paint for Draft / Auto Repair checkbox columns.
       {0} = mech name, {1} = column name, {2} = value label, {3} = position.
       CannotApply: {0} = mech name, {1} = column name, {2} = position. -->
  <RimWorldAccess.Mechs.Paint.Single.CellAlready>{0}: {1} já {2}. {3}</RimWorldAccess.Mechs.Paint.Single.CellAlready>
  <RimWorldAccess.Mechs.Paint.Single.CellApplied>{0}: {1} {2}. {3}</RimWorldAccess.Mechs.Paint.Single.CellApplied>
  <RimWorldAccess.Mechs.Paint.Single.CannotApply>{0}: impossível aplicar {1}. {2}</RimWorldAccess.Mechs.Paint.Single.CannotApply>

  <!-- Single-step paint for the Control Group column. {0} = mech name,
       {1} = control-group index (where applicable), {2} = position. The
       "no source group" case takes no mech name (the source has nothing to
       copy), so it is a bare phrase. -->
  <RimWorldAccess.Mechs.Paint.ControlGroup.NoGroupToPaint>Nenhum grupo de controlo para pintar</RimWorldAccess.Mechs.Paint.ControlGroup.NoGroupToPaint>
  <RimWorldAccess.Mechs.Paint.ControlGroup.GestatingCannotAssign>{0}: em gestação, impossível atribuir. {1}</RimWorldAccess.Mechs.Paint.ControlGroup.GestatingCannotAssign>
  <RimWorldAccess.Mechs.Paint.ControlGroup.DifferentOverseer>{0}: supervisor diferente, impossível pintar. {1}</RimWorldAccess.Mechs.Paint.ControlGroup.DifferentOverseer>
  <RimWorldAccess.Mechs.Paint.ControlGroup.AlreadyInGroup>{0}: já no grupo {1}. {2}</RimWorldAccess.Mechs.Paint.ControlGroup.AlreadyInGroup>
  <RimWorldAccess.Mechs.Paint.ControlGroup.AssignedToGroup>{0}: atribuído ao grupo {1}. {2}</RimWorldAccess.Mechs.Paint.ControlGroup.AssignedToGroup>

  <!-- =================================================================
       Bulk paint summaries (Shift+Home / Shift+End / Ctrl+Shift+...).
       Allowed Area: {0} = column name, {1} = area label, {2} = name list.
       AreaAlreadyAll: {0} = area label.
       Group: {0} = column name, {1} = group index, {2} = name list.
       GroupAlreadyAll: {0} = group index (covers "or different overseer").
       Checkbox columns: {0} = column name, {1} = value label, {2} = list.
       CellAlreadyAll: {0} = column name, {1} = value label. -->
  <RimWorldAccess.Mechs.Paint.Bulk.AreaApplied>{0} pintada como {1} para {2}</RimWorldAccess.Mechs.Paint.Bulk.AreaApplied>
  <RimWorldAccess.Mechs.Paint.Bulk.AreaAlreadyAll>Área permitida já definida como {0} para todos os mecanoides</RimWorldAccess.Mechs.Paint.Bulk.AreaAlreadyAll>
  <RimWorldAccess.Mechs.Paint.Bulk.GroupApplied>{0} pintado como grupo {1} para {2}</RimWorldAccess.Mechs.Paint.Bulk.GroupApplied>
  <RimWorldAccess.Mechs.Paint.Bulk.GroupAlreadyAll>Todos já no grupo {0} (ou com supervisor diferente)</RimWorldAccess.Mechs.Paint.Bulk.GroupAlreadyAll>
  <RimWorldAccess.Mechs.Paint.Bulk.CellApplied>Pintado {0} {1} para {2}</RimWorldAccess.Mechs.Paint.Bulk.CellApplied>
  <RimWorldAccess.Mechs.Paint.Bulk.CellAlreadyAll>Tudo já {1}</RimWorldAccess.Mechs.Paint.Bulk.CellAlreadyAll>


  <!-- Percentage range readout: {0} = min percent, {1} = max percent. -->
  <RimWorldAccess.Mechs.PercentRange>{0} a {1}</RimWorldAccess.Mechs.PercentRange>
</LanguageData>
