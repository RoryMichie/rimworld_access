<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Colony Manager Redux compatibility strings (src/Compat/ColonyManagerRedux/).
    Only OUR OWN wording lives here. Everything the mod names, it names itself
    at runtime: tab labels and their disabled reasons, job labels and target
    lists, the stamp tooltips for a suspended or completed job, the progress
    bar's status text, and the update interval's own label are all read live
    from the mod's tabs, jobs and triggers.
  -->

  <!-- The two typed content components: the mod's icon strip, and the job list
       of whichever tab it has selected. The third component, the window's own
       buttons, is named by the shared shell. -->
  <RimWorldAccess.Cmr.TabsRegion>Pestañas del gestor</RimWorldAccess.Cmr.TabsRegion>
  <RimWorldAccess.Cmr.JobsRegion>Trabajos</RimWorldAccess.Cmr.JobsRegion>

  <!-- Spoken once after switching tab. {0} = the tab's own label. -->
  <RimWorldAccess.Cmr.TabSwitched>Pestaña {0}.</RimWorldAccess.Cmr.TabSwitched>

  <!-- A job row's state, one of these four, spoken ahead of the mod's own
       tooltip for that state. "Suspended by an error" is the state the mod
       shows with an error box around the row rather than a plain paused stamp;
       "Not managed" is a job that exists but was never handed to the manager. -->
  <RimWorldAccess.Cmr.Suspended>Suspendido</RimWorldAccess.Cmr.Suspended>
  <RimWorldAccess.Cmr.SuspendedByError>Suspendido por un error</RimWorldAccess.Cmr.SuspendedByError>
  <RimWorldAccess.Cmr.Completed>Objetivo alcanzado</RimWorldAccess.Cmr.Completed>
  <RimWorldAccess.Cmr.NotManaged>No gestionado</RimWorldAccess.Cmr.NotManaged>
  <RimWorldAccess.Cmr.Active>Activo</RimWorldAccess.Cmr.Active>

  <!-- Spoken when the Manage! toolbar button commits a job to the manager, the
       moment its state turns from "Not managed" to managed. -->
  <RimWorldAccess.Cmr.NowManaged>Ahora gestionado</RimWorldAccess.Cmr.NowManaged>

  <!-- The clock zone of a job row: how long since the manager last worked the
       job, and how often it is due to. {0} = a period ("2 days") for the
       first, the mod's own interval label ("daily") for the second. -->
  <RimWorldAccess.Cmr.NeverUpdated>Nunca actualizado</RimWorldAccess.Cmr.NeverUpdated>
  <RimWorldAccess.Cmr.UpdatedAgo>Actualizado hace {0}</RimWorldAccess.Cmr.UpdatedAgo>
  <RimWorldAccess.Cmr.ChecksInterval>Revisa {0}</RimWorldAccess.Cmr.ChecksInterval>

  <!-- Spoken after suspending or resuming a job. {0} = the job's own label. -->
  <RimWorldAccess.Cmr.JobSuspended>{0}: suspendido.</RimWorldAccess.Cmr.JobSuspended>
  <RimWorldAccess.Cmr.JobUnsuspended>{0}: activo de nuevo.</RimWorldAccess.Cmr.JobUnsuspended>

  <!-- The selected job's settings column. The mod draws it with no heading of its
       own (the headings inside it, one per group of settings, are the mod's and
       are spoken as they are crossed); the animal column next to it carries the
       mod's own "Allowed animals" heading, so that region needs no key here. -->
  <RimWorldAccess.Cmr.OptionsRegion>Opciones</RimWorldAccess.Cmr.OptionsRegion>

  <!-- The two icon buttons over the animal list, which the mod draws with no
       hover text of any kind: the refresh arrows and the padlock. -->
  <RimWorldAccess.Cmr.Hunting.RefreshAnimals>Actualizar la lista de animales</RimWorldAccess.Cmr.Hunting.RefreshAnimals>
  <RimWorldAccess.Cmr.Hunting.AnimalsRefreshed>Lista de animales actualizada.</RimWorldAccess.Cmr.Hunting.AnimalsRefreshed>
  <RimWorldAccess.Cmr.Hunting.LockAnimalsToMap>Limitar la lista a los animales de este mapa</RimWorldAccess.Cmr.Hunting.LockAnimalsToMap>

  <!-- The three controls the mod's threshold details window draws around its item
       filter, none of which it labels: a button showing only a comparison glyph,
       a bare number field beside it, and a grid of stockpile cells. The window's
       own name, its filter tree, the operator names and their explanations, and
       every stockpile cell's label are all the mod's own. The target-count key
       also names every threshold tab's unnamed slider row, one phrase for one
       control everywhere it appears. -->
  <RimWorldAccess.Cmr.Threshold.OperatorRow>Comparación</RimWorldAccess.Cmr.Threshold.OperatorRow>
  <RimWorldAccess.Cmr.Threshold.TargetCountRow>Cantidad objetivo</RimWorldAccess.Cmr.Threshold.TargetCountRow>
  <RimWorldAccess.Cmr.Threshold.StockpileRow>Cantidad en</RimWorldAccess.Cmr.Threshold.StockpileRow>

  <!-- The claw icon on an animal's row, which the mod draws without hover text.
       It marks an animal likely to turn on its hunter; how likely is already in
       the mod's own aggressiveness line, read out with the rest of the row. -->
  <RimWorldAccess.Cmr.Hunting.RevengeRisk>Riesgo de venganza</RimWorldAccess.Cmr.Hunting.RevengeRisk>

  <!-- The Forestry, Foraging and Mining clones of the Hunting rows above: the
       tooltipless refresh and padlock icons over each tab's own list. Mining's
       buildings column has only a padlock, no refresh icon of its own; the
       minerals column's refresh already covers both lists. -->
  <RimWorldAccess.Cmr.Forestry.RefreshTrees>Actualizar la lista de árboles</RimWorldAccess.Cmr.Forestry.RefreshTrees>
  <RimWorldAccess.Cmr.Forestry.TreesRefreshed>Lista de árboles actualizada.</RimWorldAccess.Cmr.Forestry.TreesRefreshed>
  <RimWorldAccess.Cmr.Forestry.LockTreesToMap>Limitar la lista a los árboles de este mapa</RimWorldAccess.Cmr.Forestry.LockTreesToMap>

  <RimWorldAccess.Cmr.Foraging.RefreshPlants>Actualizar la lista de plantas</RimWorldAccess.Cmr.Foraging.RefreshPlants>
  <RimWorldAccess.Cmr.Foraging.PlantsRefreshed>Lista de plantas actualizada.</RimWorldAccess.Cmr.Foraging.PlantsRefreshed>
  <RimWorldAccess.Cmr.Foraging.LockPlantsToMap>Limitar la lista a las plantas de este mapa</RimWorldAccess.Cmr.Foraging.LockPlantsToMap>

  <RimWorldAccess.Cmr.Mining.RefreshMinerals>Actualizar la lista de minerales</RimWorldAccess.Cmr.Mining.RefreshMinerals>
  <RimWorldAccess.Cmr.Mining.MineralsRefreshed>Lista de minerales actualizada.</RimWorldAccess.Cmr.Mining.MineralsRefreshed>
  <RimWorldAccess.Cmr.Mining.LockMineralsToMap>Limitar la lista a los minerales de este mapa</RimWorldAccess.Cmr.Mining.LockMineralsToMap>
  <RimWorldAccess.Cmr.Mining.LockBuildingsToMap>Limitar la lista a las construcciones de este mapa</RimWorldAccess.Cmr.Mining.LockBuildingsToMap>

  <!-- The Livestock tab. Our wording only: everything the mod names uses the mod's own
       keys. The "{0}" of the first three is the mod's own whole-phrase age and sex label
       ("adult female"), composed by its own AgeAndSexExtensions.GetLabel. -->
  <RimWorldAccess.Cmr.Livestock.JobOpened>Trabajo de {0} abierto para configurar.</RimWorldAccess.Cmr.Livestock.JobOpened>
  <RimWorldAccess.Cmr.Livestock.CountTarget>Cantidad objetivo de {0}</RimWorldAccess.Cmr.Livestock.CountTarget>
  <RimWorldAccess.Cmr.Livestock.RestrictAreaRow>Área de {0}</RimWorldAccess.Cmr.Livestock.RestrictAreaRow>

  <!-- The five area strips the mod draws under a send-to-area toggle with no label of their own. -->
  <RimWorldAccess.Cmr.Livestock.CullingAreaRow>Área de sacrificio selectivo</RimWorldAccess.Cmr.Livestock.CullingAreaRow>
  <RimWorldAccess.Cmr.Livestock.MilkingAreaRow>Área de ordeño</RimWorldAccess.Cmr.Livestock.MilkingAreaRow>
  <RimWorldAccess.Cmr.Livestock.ShearingAreaRow>Área de esquila</RimWorldAccess.Cmr.Livestock.ShearingAreaRow>
  <RimWorldAccess.Cmr.Livestock.TrainingAreaRow>Área de entrenamiento</RimWorldAccess.Cmr.Livestock.TrainingAreaRow>
  <RimWorldAccess.Cmr.Livestock.TrainedAreaRow>Área de animales entrenados</RimWorldAccess.Cmr.Livestock.TrainedAreaRow>

  <!-- The Production tab. Our wording only: everything the mod names uses the mod's own keys. -->
  <RimWorldAccess.Cmr.Production.JobOpened>Trabajo de {0} abierto para configurar.</RimWorldAccess.Cmr.Production.JobOpened>
  <RimWorldAccess.Cmr.Production.WorkbenchAreaRow>Área de la mesa de trabajo</RimWorldAccess.Cmr.Production.WorkbenchAreaRow>

  <!-- The row that follows an ingredient with a producer link: {0} is the ingredient's own label. -->
  <RimWorldAccess.Cmr.Production.SupplyLinkRow>Enlace de suministro de {0}</RimWorldAccess.Cmr.Production.SupplyLinkRow>

  <!-- Spoken after jumping to a linked job from either side of the LinkedJobs section. -->
  <RimWorldAccess.Cmr.Production.LinkedJobSelected>{0} seleccionado.</RimWorldAccess.Cmr.Production.LinkedJobSelected>

  <!-- A linked consumer that currently covers nothing still reports its demand; the mod's own
       "Supplies: {0} (needs {1})" line would read as a bare "Supplies:" there. -->
  <RimWorldAccess.Cmr.Production.LinkedRow.Demand>Necesita {0}</RimWorldAccess.Cmr.Production.LinkedRow.Demand>

  <!-- The Overview tab. The workers region normally carries the selected work type's own gerund
       (the mod's own table header); the key below is only its fallback, and the one-row region
       over it holds the jump the sighted row's tab icon performs. -->
  <RimWorldAccess.Cmr.Overview.SelectedJobRegion>Trabajo seleccionado</RimWorldAccess.Cmr.Overview.SelectedJobRegion>
  <RimWorldAccess.Cmr.Overview.WorkersRegion>Trabajadores</RimWorldAccess.Cmr.Overview.WorkersRegion>

  <!-- The Logs tab. A job row there is the mod's log filter (its click selects a job to filter
       by, and re-clicking clears it), so Enter on a job row speaks one of these two. -->
  <RimWorldAccess.Cmr.Logs.LogsRegion>Registros</RimWorldAccess.Cmr.Logs.LogsRegion>
  <RimWorldAccess.Cmr.Logs.FilterApplied>Mostrando registros de {0}.</RimWorldAccess.Cmr.Logs.FilterApplied>
  <RimWorldAccess.Cmr.Logs.FilterCleared>Mostrando todos los registros.</RimWorldAccess.Cmr.Logs.FilterCleared>

  <!-- The Import/Export tab. Region names for its three unlabeled panels, our names for the
       per-file rows whose buttons the mod labels without naming their target file, the bare
       name field, and the export button's disabled reason (sighted players see it greyed). -->
  <RimWorldAccess.Cmr.ImportExport.ModeRegion>Modo</RimWorldAccess.Cmr.ImportExport.ModeRegion>
  <RimWorldAccess.Cmr.ImportExport.FilesRegion>Archivos guardados</RimWorldAccess.Cmr.ImportExport.FilesRegion>
  <RimWorldAccess.Cmr.ImportExport.ExportRegion>Exportar</RimWorldAccess.Cmr.ImportExport.ExportRegion>
  <RimWorldAccess.Cmr.ImportExport.DeleteRow>Eliminar {0}</RimWorldAccess.Cmr.ImportExport.DeleteRow>
  <RimWorldAccess.Cmr.ImportExport.SetDefaultRow>Establecer {0} como la plantilla predeterminada</RimWorldAccess.Cmr.ImportExport.SetDefaultRow>
  <RimWorldAccess.Cmr.ImportExport.FileNameRow>Nombre del archivo</RimWorldAccess.Cmr.ImportExport.FileNameRow>
  <RimWorldAccess.Cmr.ImportExport.ExportNeedsSelection>Selecciona al menos un trabajo primero.</RimWorldAccess.Cmr.ImportExport.ExportNeedsSelection>

  <!-- The Power tab. Its three panels are graphs with legends; the legends and the period
       control are the readable data, and these name the three panels the mod leaves unnamed. -->
  <RimWorldAccess.Cmr.Power.OverallRegion>Resumen de energía</RimWorldAccess.Cmr.Power.OverallRegion>
  <RimWorldAccess.Cmr.Power.ConsumptionRegion>Consumo</RimWorldAccess.Cmr.Power.ConsumptionRegion>
  <RimWorldAccess.Cmr.Power.ProductionRegion>Producción</RimWorldAccess.Cmr.Power.ProductionRegion>
</LanguageData>
