<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Input module strings (src/Input/). Two files contribute:
      - UnifiedKeyboardPatch.cs  (central keyboard router with ~40 speak calls)
      - MapArrowKeyHandler.cs    (map arrow-key navigation prefixes + boundary)

    Text-input strings live in RimWorldAccess_TextInput.xml and are owned by
    the Input/TextInput/ subsystem; do not duplicate them here.

    The Drafting.* and Forbid.* keys have One/Many splits so translators can
    give singular and plural subject-verb agreement natural wording. The
    MultiSelectOrder.* keys are whole phrases per semantic case, mirroring
    the pattern in RimWorldAccess_Combat.xml's MultiSelect.* entries.
  -->

  <!-- Close / exit announcements. -->
  <RimWorldAccess.Input.Close.ReturnedToMap>Haritaya dönüldü</RimWorldAccess.Input.Close.ReturnedToMap>
  <RimWorldAccess.Input.Close.MenuClosed>Menü kapatıldı</RimWorldAccess.Input.Close.MenuClosed>
  <RimWorldAccess.Input.Close.GizmoMenuClosed>Komut menüsü kapatıldı</RimWorldAccess.Input.Close.GizmoMenuClosed>

  <!-- Drafting (B key). Singular "{name} Drafted" / "{name} Undrafted" for
       single-select, "everyone" / "only" / "except" phrases for multi-select.
       Status is capitalized at the start of a sentence; lower-case variants
       are used mid-phrase. -->
  <RimWorldAccess.Input.Drafting.StatusDraftedTitle>Çatışma modunda</RimWorldAccess.Input.Drafting.StatusDraftedTitle>
  <RimWorldAccess.Input.Drafting.StatusUndraftedTitle>Normal modda</RimWorldAccess.Input.Drafting.StatusUndraftedTitle>
  <RimWorldAccess.Input.Drafting.StatusDrafted>çatışma modunda</RimWorldAccess.Input.Drafting.StatusDrafted>
  <RimWorldAccess.Input.Drafting.StatusUndrafted>normal modda</RimWorldAccess.Input.Drafting.StatusUndrafted>
  <!-- {0} = pawn name, {1} = status (Drafted/Undrafted, capitalized). -->
  <RimWorldAccess.Input.Drafting.SinglePawnStatus>{0} {1}</RimWorldAccess.Input.Drafting.SinglePawnStatus>
  <!-- Multi-select drafting announcements. {0} = everyone-label from vanilla
       key, {1} = name-list, {2} = status (drafted/undrafted, lowercase). -->
  <RimWorldAccess.Input.Drafting.EveryoneStatus>{0} {1}</RimWorldAccess.Input.Drafting.EveryoneStatus>
  <RimWorldAccess.Input.Drafting.EveryoneExceptStatus>{1} hariç {0} {2}</RimWorldAccess.Input.Drafting.EveryoneExceptStatus>
  <RimWorldAccess.Input.Drafting.OnlyStatus>Yalnızca {0}: {1}</RimWorldAccess.Input.Drafting.OnlyStatus>

  <!-- Multi-select action feedback for right-bracket / left-bracket order
       menus. Whole phrases so translators can reorder subject/verb/object.
       {0} = everyone-label (EveryoneDoes/NoOneCould/EveryoneExcept) or
             name-list (OnlyDoes), {1} = action label or name-list,
       {2} = action label (EveryoneExcept only). -->
  <RimWorldAccess.Input.MultiSelectOrder.EveryoneDoes>{0} {1}</RimWorldAccess.Input.MultiSelectOrder.EveryoneDoes>
  <RimWorldAccess.Input.MultiSelectOrder.NoOneCould>Kimse yapamadı: {0}</RimWorldAccess.Input.MultiSelectOrder.NoOneCould>
  <RimWorldAccess.Input.MultiSelectOrder.EveryoneExcept>{1} hariç {0} {2}</RimWorldAccess.Input.MultiSelectOrder.EveryoneExcept>
  <RimWorldAccess.Input.MultiSelectOrder.OnlyDoes>Yalnızca {0} {1}</RimWorldAccess.Input.MultiSelectOrder.OnlyDoes>

  <!-- Multi-select guards (Alt+Space group management, reorder). -->
  <RimWorldAccess.Input.MultiSelect.NoColonistsOnMap>Bu haritada kolonici yok</RimWorldAccess.Input.MultiSelect.NoColonistsOnMap>
  <RimWorldAccess.Input.MultiSelect.CannotSaveGroups>Oyun dışında grup kaydedilemez</RimWorldAccess.Input.MultiSelect.CannotSaveGroups>
  <RimWorldAccess.Input.MultiSelect.CannotRecallGroups>Oyun dışında grup çağrılamaz</RimWorldAccess.Input.MultiSelect.CannotRecallGroups>
  <RimWorldAccess.Input.MultiSelect.CannotReorderDuringMultiSelect>Çoklu seçim sırasında yeniden sıralanamaz</RimWorldAccess.Input.MultiSelect.CannotReorderDuringMultiSelect>

  <!-- Cursor-focused actions (rename at cursor, inspection at cursor). -->
  <RimWorldAccess.Input.Cursor.NoPawnAtCursor>İmleçte kişi yok</RimWorldAccess.Input.Cursor.NoPawnAtCursor>
  <RimWorldAccess.Input.Cursor.PawnCannotBeRenamed>Bu kişi yeniden adlandırılamaz</RimWorldAccess.Input.Cursor.PawnCannotBeRenamed>
  <RimWorldAccess.Input.Cursor.NothingToInspect>Burada incelenecek bir şey yok</RimWorldAccess.Input.Cursor.NothingToInspect>
  <RimWorldAccess.Input.Cursor.InvalidPosition>Geçersiz konum</RimWorldAccess.Input.Cursor.InvalidPosition>
  <RimWorldAccess.Input.Cursor.NoAvailableActions>Kullanılabilir eylem yok</RimWorldAccess.Input.Cursor.NoAvailableActions>
  <RimWorldAccess.Input.Cursor.Coordinates>{0}, {1}</RimWorldAccess.Input.Cursor.Coordinates>

  <!-- Mouse pointer bridge (Alt+J). PointerOffset is the answer when the pointer cannot
       be moved: {0} = tile distance, {1} = compass direction of the cursor from it. -->
  <RimWorldAccess.Input.Cursor.PointerMoved>İşaretçi: {0}, {1}</RimWorldAccess.Input.Cursor.PointerMoved>
  <RimWorldAccess.Input.Cursor.PointerOffset>İmleç işaretçiden {1} yönünde {0} kare</RimWorldAccess.Input.Cursor.PointerOffset>
  <RimWorldAccess.Input.Cursor.PointerAtCursor>İşaretçi imleçte</RimWorldAccess.Input.Cursor.PointerAtCursor>
  <RimWorldAccess.Input.Cursor.PointerOffWindow>İşaretçi oyun penceresinin dışında</RimWorldAccess.Input.Cursor.PointerOffWindow>
  <RimWorldAccess.Input.Cursor.MouseTrackingOn>Fare izleme açık</RimWorldAccess.Input.Cursor.MouseTrackingOn>
  <RimWorldAccess.Input.Cursor.MouseTrackingOff>Fare izleme kapalı</RimWorldAccess.Input.Cursor.MouseTrackingOff>
  <RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOn>İşaretçinin klavyeyi takibi açık</RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOn>
  <RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOff>İşaretçinin klavyeyi takibi kapalı</RimWorldAccess.Input.Cursor.PointerFollowsKeyboardOff>

  <!-- F1 work menu, F4 animals/mechs menu. -->
  <RimWorldAccess.Input.WorkMenu.NoColonistsAvailable>Kullanılabilir kolonici yok</RimWorldAccess.Input.WorkMenu.NoColonistsAvailable>
  <RimWorldAccess.Input.AnimalsMenu.NoAnimalsOrMechs>Hayvan veya mekanoit yok</RimWorldAccess.Input.AnimalsMenu.NoAnimalsOrMechs>

  <!-- Gizmo availability guard (G key). -->

  <!-- Right/left bracket order execution feedback. -->
  <!-- {0} = single-pawn prefix ("Bob: " or ""), {1} = action label. -->
  <RimWorldAccess.Input.Order.TopOptionUnavailable>{0}{1}, kullanılamaz</RimWorldAccess.Input.Order.TopOptionUnavailable>
  <!-- {0} = pawn name, {1} = action label, {2} = vanilla "Queued" label. -->
  <RimWorldAccess.Input.Order.QueuedAction>{0}: {1}, {2}</RimWorldAccess.Input.Order.QueuedAction>
  <!-- {0} = pawn name, {1} = action label. -->
  <RimWorldAccess.Input.Order.Action>{0}: {1}</RimWorldAccess.Input.Order.Action>
  <!-- {0} = GoHere label from vanilla. Suffix marks the line-formation variant. -->
  <RimWorldAccess.Input.Order.FormationOption>{0} (dizilim)</RimWorldAccess.Input.Order.FormationOption>

  <!-- Unforbid All (Alt+F). One/Many split for subject-verb agreement. -->
  <RimWorldAccess.Input.Unforbid.NoForbiddenItems>Haritada yasaklı öğe bulunamadı</RimWorldAccess.Input.Unforbid.NoForbiddenItems>
  <RimWorldAccess.Input.Unforbid.CountOne>1 öğeye izin verildi</RimWorldAccess.Input.Unforbid.CountOne>
  <RimWorldAccess.Input.Unforbid.CountMany>{0} öğeye izin verildi</RimWorldAccess.Input.Unforbid.CountMany>

  <!-- Toggle forbid at cursor (F key). One/Many + forbidden/unforbidden
       splits so translators can give the plural subject correct agreement. -->
  <RimWorldAccess.Input.Forbid.NothingToForbid>Bu konumda yasaklanacak veya izin verilecek bir şey yok</RimWorldAccess.Input.Forbid.NothingToForbid>
  <!-- {0} = item label. -->
  <RimWorldAccess.Input.Forbid.SingleForbidden>{0} yasaklandı</RimWorldAccess.Input.Forbid.SingleForbidden>
  <RimWorldAccess.Input.Forbid.SingleUnforbidden>{0} artık yasaklı değil</RimWorldAccess.Input.Forbid.SingleUnforbidden>
  <!-- {0} = toggled count. -->
  <RimWorldAccess.Input.Forbid.ManyForbidden>{0} öğe yasaklandı</RimWorldAccess.Input.Forbid.ManyForbidden>
  <RimWorldAccess.Input.Forbid.ManyUnforbidden>{0} öğe artık yasaklı değil</RimWorldAccess.Input.Forbid.ManyUnforbidden>

  <!-- Map arrow-key navigation prefixes (MapArrowKeyHandler.cs).
       Composed with the tile info that follows, e.g. "Selected, stone, ...".
       {0} = tile info. -->
  <RimWorldAccess.Input.Map.Boundary>Harita sınırı</RimWorldAccess.Input.Map.Boundary>
  <RimWorldAccess.Input.Map.PrefixSelected>Seçildi, {0}</RimWorldAccess.Input.Map.PrefixSelected>
  <RimWorldAccess.Input.Map.PrefixFirstPoint>Birinci nokta, {0}</RimWorldAccess.Input.Map.PrefixFirstPoint>
  <RimWorldAccess.Input.Map.PrefixSecondPoint>İkinci nokta, {0}</RimWorldAccess.Input.Map.PrefixSecondPoint>
  <RimWorldAccess.Input.Map.PrefixInArea>Alan içinde, {0}</RimWorldAccess.Input.Map.PrefixInArea>
  <RimWorldAccess.Input.Map.PrefixDisconnected>Bağlantısı kesik, {0}</RimWorldAccess.Input.Map.PrefixDisconnected>

  <!-- Schedule editor visual overlay (src/Input/UnifiedKeyboardPatch.cs). -->
</LanguageData>
