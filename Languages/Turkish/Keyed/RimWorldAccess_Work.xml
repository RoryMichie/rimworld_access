<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Work module strings (src/Work/). Two files contribute:
      - WorkMenuState.cs  (priority grid, basic-mode list, bulk-set, search)
      - WorkMenuPatch.cs  (visual overlay rendered while the menu is open)

    The work menu has two modes: a 5-column priority grid (Manual Priority
    Mode: Priority 1..4 plus Disabled) and a single-list Basic Mode. Both
    modes speak the same item details - labelShort, skill/passion info, and
    a position suffix - composed from these keys. Column names, priority
    words, mode names and placement-context phrases are deliberately kept
    as small building blocks so translators can reorder them inside the
    composed announcements.

    Placeholders follow string.Format ({0}, {1}, ...). All dynamic data -
    pawn names, work-type labelShort, skill labels, counts, reason lists -
    comes from the game and is NOT translated in this file.

    Singular/plural keys (.One/.Many) are used where English needs
    subject-verb agreement (e.g. "1 already set" vs "3 already set");
    other languages can collapse or split these further as grammar needs.
  -->

  <!-- Menu lifecycle announcements (open, cancel, confirm).
       OpeningTitle is spoken when the menu first appears; the current
       position announcement follows it immediately. -->
  <RimWorldAccess.Work.Saved>İş tercihleri kaydedildi</RimWorldAccess.Work.Saved>

  <!-- Pawn switch via Tab / Shift+Tab.
       SavedPrefix is prepended when the previous pawn had pending changes.
       {0} = previous pawn name, {1} = brief announcement for the new pawn. -->
  <RimWorldAccess.Work.PawnSwitch.SavedPrefix>{0} kaydedildi. {1}</RimWorldAccess.Work.PawnSwitch.SavedPrefix>

  <!-- Fallback pawn name used when LabelShort is unavailable. Rare;
       mostly defensive for null-check paths. -->
  <RimWorldAccess.Work.UnknownPawn>Bilinmeyen</RimWorldAccess.Work.UnknownPawn>

  <!-- Work-priority copy/paste (Ctrl+C / Ctrl+V), sharing vanilla's own
       clipboard. CopyPasteAnnouncement: {0} = the game's own Copy/Paste word,
       {1} = pawn name. NoPrioritiesCopied is the refusal when nothing has been
       copied yet. -->
  <RimWorldAccess.Work.CopyPasteAnnouncement>{0}: {1}</RimWorldAccess.Work.CopyPasteAnnouncement>
  <RimWorldAccess.Work.NoPrioritiesCopied>Kopyalanmış iş önceliği yok</RimWorldAccess.Work.NoPrioritiesCopied>

  <!-- Mode names. Toggle (Alt+M) announces just the new mode; the overlay
       shows the same strings in the header row. -->
  <RimWorldAccess.Work.Mode.Manual>Manuel öncelik modu</RimWorldAccess.Work.Mode.Manual>
  <RimWorldAccess.Work.Mode.Basic>Temel mod</RimWorldAccess.Work.Mode.Basic>

  <!-- Spoken when Up/Down is pressed in Basic Mode (navigation is
       Left/Right only there). -->

  <!-- Column names for the 5-column priority grid. Used in the spoken
       announcements, the overlay's position readout, and composed into
       phrases like "{column}: empty". -->
  <RimWorldAccess.Work.Column.Priority1>Öncelik 1</RimWorldAccess.Work.Column.Priority1>
  <RimWorldAccess.Work.Column.Priority2>Öncelik 2</RimWorldAccess.Work.Column.Priority2>
  <RimWorldAccess.Work.Column.Priority3>Öncelik 3</RimWorldAccess.Work.Column.Priority3>
  <RimWorldAccess.Work.Column.Priority4>Öncelik 4</RimWorldAccess.Work.Column.Priority4>
  <RimWorldAccess.Work.Column.Disabled>Devre dışı</RimWorldAccess.Work.Column.Disabled>
  <RimWorldAccess.Work.Column.Unknown>Bilinmeyen</RimWorldAccess.Work.Column.Unknown>

  <!-- Bare priority word used inside composed announcements.
       For columns 0-3 (Priority 1-4) this is just the digit; column 4
       is the localized word "disabled". Example composition:
       "mine, 2, placed right of cooking". -->
  <RimWorldAccess.Work.PriorityWord.1>1</RimWorldAccess.Work.PriorityWord.1>
  <RimWorldAccess.Work.PriorityWord.2>2</RimWorldAccess.Work.PriorityWord.2>
  <RimWorldAccess.Work.PriorityWord.3>3</RimWorldAccess.Work.PriorityWord.3>
  <RimWorldAccess.Work.PriorityWord.4>4</RimWorldAccess.Work.PriorityWord.4>
  <RimWorldAccess.Work.PriorityWord.Disabled>devre dışı</RimWorldAccess.Work.PriorityWord.Disabled>

  <!-- Empty-column / empty-list announcements.
       ColumnEmpty: {0} = column name. Spoken when the current column has
       no items (e.g. "Priority 3: empty").
       NoWorkTypesAvailable: Basic Mode, no entries at all.
       NoWorkTypeSelected: Shift+0-4 bulk set with no entry under cursor.
       NoTaskSelected: BuildTaskAnnouncement fallback.
       CursorNowEmpty: {0} = column name. Spoken after SetPriority moved
       the only item out of the current column. -->
  <RimWorldAccess.Work.NoWorkTypeSelected>Seçili iş türü yok</RimWorldAccess.Work.NoWorkTypeSelected>

  <!-- Single-pawn SetPriority feedback.
       AlreadyAtPriority: {0} = work labelShort, {1} = priority word
         (e.g. "mine already at 3" / "cleaning already at disabled").
       MovedToDisabled: {0} = work labelShort. Spoken when an item is
         moved to the Disabled column (no placement context follows).
       MovedToPriority: {0} = labelShort, {1} = priority word. Used when
         the new column has only one movable item, so no neighbour context.
       MovedToPriorityWithContext: {0} = labelShort, {1} = priority word,
         {2} = placement-context clause (trimmed, without "placed " prefix). -->
  <RimWorldAccess.Work.SetPriority.AlreadyAtPriority>{0} zaten {1}</RimWorldAccess.Work.SetPriority.AlreadyAtPriority>
  <RimWorldAccess.Work.SetPriority.MovedToDisabled>{0}, devre dışı</RimWorldAccess.Work.SetPriority.MovedToDisabled>
  <RimWorldAccess.Work.SetPriority.MovedToPriority>{0}, {1}</RimWorldAccess.Work.SetPriority.MovedToPriority>
  <RimWorldAccess.Work.SetPriority.MovedToPriorityWithContext>{0}, {1}, {2}</RimWorldAccess.Work.SetPriority.MovedToPriorityWithContext>

  <!-- Basic Mode toggle status suffix and disabled-entry status word.
       Status.Enabled / Status.Disabled: post-priority state in Basic Mode.
       PriorityLabel: priority-label used inside the bulk-set announcement
         and the pawn-switch summary. {0} = priority number. -->
  <RimWorldAccess.Work.Status.Enabled>etkin</RimWorldAccess.Work.Status.Enabled>
  <RimWorldAccess.Work.Status.Disabled>devre dışı</RimWorldAccess.Work.Status.Disabled>
  <RimWorldAccess.Work.PriorityLabel>Öncelik {0}</RimWorldAccess.Work.PriorityLabel>

  <!-- Cannot-enable announcement for permanently disabled work types.
       {0} = comma-joined reasons from pawn.GetReasonsForDisabledWorkType. -->
  <RimWorldAccess.Work.CannotEnable>Etkinleştirilemez: Kalıcı olarak devre dışı, {0}</RimWorldAccess.Work.CannotEnable>

  <!-- BuildTaskAnnouncement (composed item description).
       PermanentlyDisabledPrefix is appended after the labelShort and is
       followed by the comma-joined reasons list - no placeholder; C#
       concatenates. -->
  <RimWorldAccess.Work.Task.PermanentlyDisabledPrefix>. Kalıcı olarak devre dışı: </RimWorldAccess.Work.Task.PermanentlyDisabledPrefix>
  <RimWorldAccess.Work.Task.UnskilledLabor>. Beceri istemeyen iş.</RimWorldAccess.Work.Task.UnskilledLabor>

  <!-- Skill level phrases.
       LevelSuffix: {0} = integer skill level. Spoken when the one relevant
         skill has the same name as the work type (no need to repeat it).
       SkillsAndLevelSuffix: {0} = skill level. Follows the comma-joined
         skill-name list built in C# (e.g. "Melee and Shooting: level 8"). -->
  <RimWorldAccess.Work.Task.LevelSuffix>. Seviye {0}</RimWorldAccess.Work.Task.LevelSuffix>
  <RimWorldAccess.Work.Task.SkillsAndLevelSuffix>: seviye {0}</RimWorldAccess.Work.Task.SkillsAndLevelSuffix>
  <!-- Separator between the final two skill names (" and "). Kept as a
       key so languages that don't use a coordinating conjunction can
       render an empty or punctuation-only separator. -->
  <RimWorldAccess.Work.Task.SkillListAndSeparator> ve </RimWorldAccess.Work.Task.SkillListAndSeparator>

  <!-- Passion suffixes appended at the end of the task announcement. -->

  <!-- Placement context announced after a SetPriority move, describing
       where the item landed inside the destination column. Composed
       by MovedToPriorityWithContext.
       {0} = neighbour (or left neighbour), {1} = right neighbour. -->
  <RimWorldAccess.Work.PlacementContext.LeftOf>{0} solunda</RimWorldAccess.Work.PlacementContext.LeftOf>
  <RimWorldAccess.Work.PlacementContext.RightOf>{0} sağında</RimWorldAccess.Work.PlacementContext.RightOf>
  <RimWorldAccess.Work.PlacementContext.FirstLeftOf>ilk sırada, {0} solunda</RimWorldAccess.Work.PlacementContext.FirstLeftOf>
  <RimWorldAccess.Work.PlacementContext.LastRightOf>son sırada, {0} sağında</RimWorldAccess.Work.PlacementContext.LastRightOf>
  <RimWorldAccess.Work.PlacementContext.Between>{0} ile {1} arasında</RimWorldAccess.Work.PlacementContext.Between>

  <!-- Bulk-set announcement (Shift+0-4: apply priority to all pawns).
       {0} = work type labelShort, {1} = priority label (e.g. "Priority 2"
       or the localized "disabled" word), {2} = comma-joined name list or
       the count for "already set".
       AlreadySetOne / AlreadySetMany split on English subject-verb
       agreement: "1 already set" vs "3 already set". -->
  <RimWorldAccess.Work.BulkSet.NoCapableColonists>Hiçbir kolonici {0} yapamaz</RimWorldAccess.Work.BulkSet.NoCapableColonists>
  <RimWorldAccess.Work.BulkSet.AlreadyForAll>{0} işi, tüm koloniciler için zaten {1}</RimWorldAccess.Work.BulkSet.AlreadyForAll>
  <RimWorldAccess.Work.BulkSet.AlreadyForAllCapable>{0} işi, yapabilen tüm koloniciler için zaten {1}</RimWorldAccess.Work.BulkSet.AlreadyForAllCapable>
  <RimWorldAccess.Work.BulkSet.SetForAll>Tüm kolonicilerin {0} işi {1} olarak ayarlandı</RimWorldAccess.Work.BulkSet.SetForAll>
  <RimWorldAccess.Work.BulkSet.SetForAllExcept>{0} işi, {2} hariç herkes için {1} olarak ayarlandı</RimWorldAccess.Work.BulkSet.SetForAllExcept>
  <RimWorldAccess.Work.BulkSet.SetForList>{0} işi, {2} için {1} olarak ayarlandı</RimWorldAccess.Work.BulkSet.SetForList>
  <RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetOne>{0} işi, {2} için {1} olarak ayarlandı. {3} kişi zaten ayarlıydı</RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetOne>
  <RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetMany>{0} işi, {2} için {1} olarak ayarlandı. {3} kişi zaten ayarlıydı</RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetMany>

  <!-- FormatNameList joiners. English uses Oxford-comma "A, B, and C" for
       3+ and plain "A and B" for 2; other languages can re-map the
       separators. Two/ThreePlusLast both have {0} = earlier names,
       {1} = last name. -->
  <RimWorldAccess.Work.NameList.Two>{0} ve {1}</RimWorldAccess.Work.NameList.Two>
  <RimWorldAccess.Work.NameList.ThreePlusLastJoiner> ve </RimWorldAccess.Work.NameList.ThreePlusLastJoiner>
  <RimWorldAccess.Work.NameList.Separator>, </RimWorldAccess.Work.NameList.Separator>

  <!-- Typeahead search jump prompt.
       {0} = task announcement, {1} = column name, {2} = current match 1-
       based, {3} = total matches. Pattern mirrors the feature's other
       position announcements. -->

  <!-- Pawn-switch brief announcement composition (no entry case).
       {0} = pawn name, {1} = position suffix "{i} of {n}". -->
  <RimWorldAccess.Work.PawnSwitch.NoEntry>{0}. {1}</RimWorldAccess.Work.PawnSwitch.NoEntry>

  <!-- Pawn-switch brief announcement with an entry, permanently disabled.
       {0} = pawn name, {1} = work labelShort, {2} = details suffix
       (", Permanently disabled: reasons"), {3} = position suffix. -->
  <RimWorldAccess.Work.PawnSwitch.PermanentlyDisabled>{0}. {1}{2}. {3}</RimWorldAccess.Work.PawnSwitch.PermanentlyDisabled>

  <!-- Pawn-switch brief announcement with an entry and a priority.
       {0} = pawn name, {1} = work labelShort, {2} = priority label
       (localized column name or "disabled" word), {3} = details suffix,
       {4} = position suffix. -->
  <RimWorldAccess.Work.PawnSwitch.WithPriority>{0}. {1}, {2}{3}. {4}</RimWorldAccess.Work.PawnSwitch.WithPriority>

  <!-- Announcement composition for AnnounceCurrentPosition.
       WithColumn: {0} = column name, {1} = task announcement, {2} = pos.
       WithoutColumn: {0} = task announcement, {1} = pos.
       BasicModeItem: {0} = task announcement, {1} = status, {2} = pos. -->

  <!-- WorkTableState lifecycle and mode announcements.
       OpeningAnnouncement: {0} = colonist count, {1} = work type count, {2} = mode string.
       FocusedViewOpening: {0} = pawn LabelShort. Spoken when focused view opens. -->
  <RimWorldAccess.Work.Table.OpeningAnnouncement>İş, tablo görünümü, {0} kolonici, {1} iş türü, {2}</RimWorldAccess.Work.Table.OpeningAnnouncement>
  <RimWorldAccess.Work.FocusedViewOpening>İş, odaklı görünüm. {0}</RimWorldAccess.Work.FocusedViewOpening>

  <!-- Table view: sort announcements.
       CannotSort: {0} = column name.
       SortedBy: {0} = column name, {1} = direction word. -->

  <!-- Table view: priority-change feedback.
       AlreadyState: {0} = pawn LabelShort, {1} = work labelShort, {2} = state label.
       SetStateForList: {0} = work labelShort, {1} = state label, {2} = name list.
       Raised/Lowered: direction words used inside RaisedForList / LoweredForList.
       RaisedForList / LoweredForList: {0} = work labelShort, {1} = name list. -->
  <RimWorldAccess.Work.Table.AlreadyState>{0}, {1} zaten {2}</RimWorldAccess.Work.Table.AlreadyState>
  <RimWorldAccess.Work.Table.SetStateForList>{2} için {0}: {1}</RimWorldAccess.Work.Table.SetStateForList>
  <RimWorldAccess.Work.Table.Raised>yükseltildi</RimWorldAccess.Work.Table.Raised>
  <RimWorldAccess.Work.Table.Lowered>düşürüldü</RimWorldAccess.Work.Table.Lowered>
  <RimWorldAccess.Work.Table.RaisedForList>{1} için {0} yükseltildi</RimWorldAccess.Work.Table.RaisedForList>
  <RimWorldAccess.Work.Table.LoweredForList>{1} için {0} düşürüldü</RimWorldAccess.Work.Table.LoweredForList>

  <!-- Table view: painting announcements.
       PaintIncapable: {0} = target LabelShort, {1} = position string.
       PaintAlreadyState: {0} = target LabelShort, {1} = state label, {2} = position.
       PaintedState: {0} = target LabelShort, {1} = state label, {2} = position.
       RangeAlreadyState: {0} = work labelShort, {1} = state label.
       PaintedForList: {0} = work labelShort, {1} = state label, {2} = name list. -->
  <RimWorldAccess.Work.Table.PaintIncapable>{0}: mahir değil. {1}</RimWorldAccess.Work.Table.PaintIncapable>
  <RimWorldAccess.Work.Table.PaintAlreadyState>{0}: zaten {1}. {2}</RimWorldAccess.Work.Table.PaintAlreadyState>
  <RimWorldAccess.Work.Table.PaintedState>{0}: {1}. {2}</RimWorldAccess.Work.Table.PaintedState>
  <RimWorldAccess.Work.Table.RangeAlreadyState>{0}, bu aralık için zaten {1}</RimWorldAccess.Work.Table.RangeAlreadyState>
  <RimWorldAccess.Work.Table.PaintedForList>{2} için {0} işi {1} olarak boyandı</RimWorldAccess.Work.Table.PaintedForList>

  <!-- Table view: reject / guard announcements.
       SelectWorkTypeFirst: no work-type column is selected.
       CannotPaintNameColumn: painting attempted on the name column.
       NoChangeFor: {0} = work labelShort; all pawns already at the target.
       SourceIncapableOf: {0} = source pawn LabelShort, {1} = work labelShort.
       CannotDo: {0} = pawn LabelShort, {1} = work labelShort, {2} = optional reason detail (": reasons" or empty). -->
  <RimWorldAccess.Work.Table.SelectWorkTypeFirst>Önce bir iş türü sütunu seç</RimWorldAccess.Work.Table.SelectWorkTypeFirst>
  <RimWorldAccess.Work.Table.CannotPaintNameColumn>İsim sütunu boyanamaz</RimWorldAccess.Work.Table.CannotPaintNameColumn>
  <RimWorldAccess.Work.Table.NoChangeFor>{0} için değişiklik yok</RimWorldAccess.Work.Table.NoChangeFor>
  <RimWorldAccess.Work.Table.SourceIncapableOf>{0}, {1} yapamaz</RimWorldAccess.Work.Table.SourceIncapableOf>
  <RimWorldAccess.Work.Table.CannotDo>{0}, {1} yapamaz{2}</RimWorldAccess.Work.Table.CannotDo>

  <!-- WorkMenuState: cycle-all-pawns no-change and direction feedback.
       NoChangeFor: {0} = work labelShort. Used when no pawn changed.
       RaisedForList / LoweredForList reused from Work.Table above. -->
  <RimWorldAccess.Work.Menu.NoChangeFor>{0} için değişiklik yok</RimWorldAccess.Work.Menu.NoChangeFor>

  <!-- Task detail composition pieces restored/added after the merge.
       IncludesPrefix leads the comma-joined work-giver list; leading
       ". " is part of the value, matching Task.UnskilledLabor.
       IncapableWithReasons: {0} = comma-joined disabled reasons. -->
  <RimWorldAccess.Work.Task.IncludesPrefix>. İçerir: </RimWorldAccess.Work.Task.IncludesPrefix>
  <RimWorldAccess.Work.Task.IdeologyOpposes>. İdeodin bu işe karşı çıkıyor</RimWorldAccess.Work.Task.IdeologyOpposes>
  <RimWorldAccess.Work.Column.Name>İsim</RimWorldAccess.Work.Column.Name>
  <RimWorldAccess.Work.Table.Incapable>mahir değil</RimWorldAccess.Work.Table.Incapable>
  <RimWorldAccess.Work.Table.IncapableWithReasons>mahir değil, {0}</RimWorldAccess.Work.Table.IncapableWithReasons>
</LanguageData>
