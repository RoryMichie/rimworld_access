<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Shared vocabulary used by RimWorld Access helper classes. Every phrase in
    this file is emitted by a helper in src/UI, src/Map, or src/Inspection and
    represents the canonical English wording that Phase A consolidated. Each
    key is spoken many times across the mod - localizing here localizes the
    corresponding announcement everywhere it appears.

    Placeholders follow string.Format ({0}, {1}, ...). When a key has One/Many
    variants, the caller picks the form based on a count value; languages with
    additional plural classes can either keep both keys identical or split
    further using RimWorld's LanguageWorker.
  -->

  <!-- Guard preconditions (src/UI/GuardHelper.cs).
       Spoken when a state class cannot proceed because of missing game state. -->
  <RimWorldAccess.Guard.NotInGame>Oyunda değil</RimWorldAccess.Guard.NotInGame>
  <RimWorldAccess.Guard.NoMapLoaded>Yüklü harita yok</RimWorldAccess.Guard.NoMapLoaded>
  <RimWorldAccess.Guard.NoPawnSelected>Seçili kişi yok</RimWorldAccess.Guard.NoPawnSelected>
  <RimWorldAccess.Guard.NoItemSelected>Seçili öğe yok</RimWorldAccess.Guard.NoItemSelected>
  <RimWorldAccess.Guard.NoBuildingToConfigure>Ayarlanacak yapı yok</RimWorldAccess.Guard.NoBuildingToConfigure>
  <RimWorldAccess.Guard.WorldNavigationNotActive>Dünya gezinmesi etkin değil</RimWorldAccess.Guard.WorldNavigationNotActive>
  <RimWorldAccess.Guard.NoValidTileSelected>Seçili geçerli altıgen yok</RimWorldAccess.Guard.NoValidTileSelected>
  <RimWorldAccess.Guard.InvalidCursorPosition>Geçersiz imleç konumu</RimWorldAccess.Guard.InvalidCursorPosition>

  <!-- Typeahead search (src/UI/TypeaheadSearchHelper.cs).
       Used across every menu that has type-to-find search.
       {0} = the user's search text (NoMatches).
       {0} = current 1-based match position, {1} = total matches,
       {2} = search buffer (ContextSuffix). -->
  <RimWorldAccess.Search.Cleared>Arama temizlendi</RimWorldAccess.Search.Cleared>
  <RimWorldAccess.Search.Prompt>Arama</RimWorldAccess.Search.Prompt>
  <RimWorldAccess.Search.Closed>Arama kapatıldı</RimWorldAccess.Search.Closed>
  <RimWorldAccess.Search.NoMatches>'{0}' için sonuç yok</RimWorldAccess.Search.NoMatches>
  <RimWorldAccess.Search.ContextSuffix>, '{2}' için {1} sonuçtan {0}</RimWorldAccess.Search.ContextSuffix>

  <!-- Info card (src/Inspection/InfoCardState.cs).
       Spoken when an 'i'-style info-card action has no eligible target.
       Inspectable: suffix appended to a tree item's announcement when
       pressing Alt+I would open an info card; the leading space is part
       of the key so it joins onto whatever label precedes it.
       ChooseItemToInspect: float-menu prompt when the current item has
       multiple Defs that could be inspected. -->
  <RimWorldAccess.InfoCard.Unavailable>Bilgi kartı yok</RimWorldAccess.InfoCard.Unavailable>
  <RimWorldAccess.InfoCard.Inspectable> İncelenebilir.</RimWorldAccess.InfoCard.Inspectable>
  <RimWorldAccess.InfoCard.ChooseItemToInspect>İncelenecek öğeyi seç</RimWorldAccess.InfoCard.ChooseItemToInspect>

  <!-- Tree expansion state (src/UI/TreeNavigationHelper.cs).
       StateExpanded/StateCollapsed are the bare words, composed into the
       suffix keys. SuffixWithCountOne/Many are used when a child count is
       included; {0} = state word, {1} = child count.
       ExpandedCountOne/Many are spoken after ExpandAllSiblings collapses or
       expands several siblings in one action. -->
  <RimWorldAccess.Tree.StateExpanded>genişletildi</RimWorldAccess.Tree.StateExpanded>
  <RimWorldAccess.Tree.StateCollapsed>daraltıldı</RimWorldAccess.Tree.StateCollapsed>
  <RimWorldAccess.Tree.ExpansionSuffix>, {0}</RimWorldAccess.Tree.ExpansionSuffix>
  <RimWorldAccess.Tree.ExpansionSuffixWithCountOne>, {0}, {1} öğe</RimWorldAccess.Tree.ExpansionSuffixWithCountOne>
  <RimWorldAccess.Tree.ExpansionSuffixWithCountMany>, {0}, {1} öğe</RimWorldAccess.Tree.ExpansionSuffixWithCountMany>
  <RimWorldAccess.Tree.ExpansionSpaceSuffix> {0}</RimWorldAccess.Tree.ExpansionSpaceSuffix>
  <RimWorldAccess.Tree.ExpandedCountOne>{0} öğe genişletildi</RimWorldAccess.Tree.ExpandedCountOne>
  <RimWorldAccess.Tree.ExpandedCountMany>{0} öğe genişletildi</RimWorldAccess.Tree.ExpandedCountMany>
  <!-- No-op feedback for ExpandAllSiblings: everything at this level was
       already open, or nothing here can expand. -->
  <RimWorldAccess.Tree.AllAlreadyExpanded>Tüm öğeler zaten genişletilmiş</RimWorldAccess.Tree.AllAlreadyExpanded>
  <RimWorldAccess.Tree.NoneToExpand>Genişletilebilir öğe yok</RimWorldAccess.Tree.NoneToExpand>

  <!-- Two-level menu (src/UI/TwoLevelMenuHelper.cs). Used by the mod-list detail view,
       notifications, and the History Graph sub-tab. ButtonAnnouncement/Disabled and
       ButtonDisabled/Reason retired (Task 8 packet H): button focus now speaks through
       the composer's own Button role + Disabled state, and the disabled-activation
       refusal reuses the shared RimWorldAccess.Shell.GenericWindow.Disabled key. -->
  <RimWorldAccess.TwoLevel.BackToList>Listeye dön</RimWorldAccess.TwoLevel.BackToList>
  <RimWorldAccess.TwoLevel.BackToListWithSuffix>Listeye dön. {0}</RimWorldAccess.TwoLevel.BackToListWithSuffix>

  <!-- Menu formatting (src/UI/MenuHelper.cs).
       Position: {0} = 1-based index, {1} = total.
       LevelSuffix: {0} = indent level (1-based), appended to item announcements.
       CannotPaintColumn: tabular menus when a column cannot be paint-copied. -->
  <RimWorldAccess.Menu.Position>{0} / {1}</RimWorldAccess.Menu.Position>
  <RimWorldAccess.Menu.TabPosition>sekme {0} / {1}</RimWorldAccess.Menu.TabPosition>
  <RimWorldAccess.Menu.LevelSuffix> seviye {0}</RimWorldAccess.Menu.LevelSuffix>
  <RimWorldAccess.Menu.CannotPaintColumn>Bu sütun boyanamaz</RimWorldAccess.Menu.CannotPaintColumn>

  <!-- Edge announcements (src/UI/MenuHelper.cs, MenuHelper.EdgeDirection).
       Spoken when navigation has reached a boundary and cannot continue. -->
  <RimWorldAccess.Edge.Top>Zaten en üstte</RimWorldAccess.Edge.Top>
  <RimWorldAccess.Edge.Bottom>Zaten en altta</RimWorldAccess.Edge.Bottom>
  <RimWorldAccess.Edge.First>Zaten ilk konumda</RimWorldAccess.Edge.First>
  <RimWorldAccess.Edge.Last>Zaten son konumda</RimWorldAccess.Edge.Last>
  <RimWorldAccess.Edge.Minimum>Zaten en az değerde</RimWorldAccess.Edge.Minimum>
  <RimWorldAccess.Edge.Maximum>Zaten en çok değerde</RimWorldAccess.Edge.Maximum>
  <RimWorldAccess.Edge.TopLevel>Zaten en üst seviyede</RimWorldAccess.Edge.TopLevel>
  <RimWorldAccess.Edge.Zero>Zaten sıfırda</RimWorldAccess.Edge.Zero>
  <RimWorldAccess.Edge.Generic>Zaten sınırda</RimWorldAccess.Edge.Generic>

  <!-- Map navigation (src/Map/MapNavigationState.cs).
       JumpedTo: {0} = the target label (scanner item, menu row, etc.).
       JumpedToTarget: fallback when no label is available.
       SelectedCell: {0} = cell x, {1} = cell z. -->
  <RimWorldAccess.Map.JumpedTo>Gidildi: {0}</RimWorldAccess.Map.JumpedTo>
  <RimWorldAccess.Map.JumpedToTarget>Hedefe gidildi</RimWorldAccess.Map.JumpedToTarget>
  <RimWorldAccess.Map.SelectedCell>Seçildi, {0}, {1}</RimWorldAccess.Map.SelectedCell>

  <!-- Numeric stepper (src/UI/NumericStepperHelper.cs).
       Minimum/Maximum are boundary hits (value did not change).
       ValueAtMinimum/Maximum are transitions INTO the boundary; {0} = the
       formatted value label. -->
  <RimWorldAccess.Stepper.Minimum>En az</RimWorldAccess.Stepper.Minimum>
  <RimWorldAccess.Stepper.Maximum>En çok</RimWorldAccess.Stepper.Maximum>
  <RimWorldAccess.Stepper.ValueAtMinimum>{0}, en az</RimWorldAccess.Stepper.ValueAtMinimum>
  <RimWorldAccess.Stepper.ValueAtMaximum>{0}, en çok</RimWorldAccess.Stepper.ValueAtMaximum>

  <!-- Generic shared labels. NameColumn is the header for a pawn-name column in
       tabular menus (skills table, assign menu). Unknown is a defensive fallback
       for an out-of-range column. Material is the generic placeholder cost word
       for a stuff-based building before a specific stuff is chosen. SortAscending/
       Descending are spoken when a table column is sorted. RenameLabeled is a
       rename gizmo label with the target's name ({0}). -->
  <RimWorldAccess.Common.NameColumn>İsim</RimWorldAccess.Common.NameColumn>
  <RimWorldAccess.Common.Unknown>Bilinmeyen</RimWorldAccess.Common.Unknown>
  <RimWorldAccess.Common.Material>malzeme</RimWorldAccess.Common.Material>
  <RimWorldAccess.Common.SortAscending>artan</RimWorldAccess.Common.SortAscending>
  <RimWorldAccess.Common.SortDescending>azalan</RimWorldAccess.Common.SortDescending>
  <RimWorldAccess.Common.RenameLabeled>Yeniden adlandır: {0}</RimWorldAccess.Common.RenameLabeled>

  <!-- Where a row dragged with the mouse would land. {0} = 1-based position,
       {1} = number of rows in the list being reordered. -->
  <RimWorldAccess.Common.Drag.ReorderPosition>Konum {0} / {1}</RimWorldAccess.Common.Drag.ReorderPosition>
</LanguageData>
