<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Mechs module strings (src/Mechs/). Two source files contribute:
      - MechsMenuState.cs   (mechanoid management tab navigation + paint)
      - MechsMenuHelper.cs  (cell value / column fallbacks)

    This tab is the Biotech mechanoid manager. Like the Animals and Wildlife
    tabs it is built on TabularMenuHelper<Pawn>, so its sort feedback, paint
    feedback, and submenu phrasing run parallel to the Animals module. The
    placeholder patterns mirror RimWorldAccess_Animals.xml deliberately so
    translators can keep the families consistent.

    Placeholders follow string.Format ({0}, {1}, ...). Game-supplied DATA is
    never translated here and is passed in as arguments instead:
      - mech names (pawn.LabelShort), area labels, work-mode LabelCaps,
        control-group indices, column header text, and the game's own draft
        reason text all come from RimWorld and stay in the player's language
        via the game's own translation system.

    Shared phrases delegated to RimWorldAccess_Common.xml (NOT redefined here):
      - position suffix ("{0} of {1}"), cannot-paint-column, edge announcements
      - typeahead search scaffolding, info-card-unavailable, jumped-to
    Vanilla keys reused directly in C# (NOT redefined here):
      - "Biotech", "Gestating", "None", "Unrestricted", "On", "Off",
        "ManageAreas", "Name", "AllowedArea", "CommandDraftLabel",
        "CommandUndraftLabel", and similar.
  -->

  <!-- =================================================================
       Shared cell fallbacks (MechsMenuHelper). "Unknown" is the out-of-range
       fallback; "N/A" is spoken for cells that don't apply to a given mech
       (e.g. no energy need, no repair comp, no control group). -->
  <RimWorldAccess.Mechs.Value.Unknown>Bilinmeyen</RimWorldAccess.Mechs.Value.Unknown>
  <RimWorldAccess.Mechs.Value.NotApplicable>Yok</RimWorldAccess.Mechs.Value.NotApplicable>

  <!-- Paint value labels for checkbox columns whose specific column has no
       dedicated wording (the Draft/AutoRepair columns supply their own via
       vanilla keys; this is the generic fallback). -->
  <RimWorldAccess.Mechs.Paint.Checked>işaretli</RimWorldAccess.Mechs.Paint.Checked>
  <RimWorldAccess.Mechs.Paint.Unchecked>işaretsiz</RimWorldAccess.Mechs.Paint.Unchecked>

  <!-- =================================================================
       MechsMenuState lifecycle and navigation announcements.
       OpeningTitle: {0} = mech count. -->
  <RimWorldAccess.Mechs.Menu.BiotechRequired>Biotech DLC gerekli</RimWorldAccess.Mechs.Menu.BiotechRequired>
  <RimWorldAccess.Mechs.Menu.NoMechsFound>Mekanoit bulunamadı</RimWorldAccess.Mechs.Menu.NoMechsFound>
  <RimWorldAccess.Mechs.Menu.OpeningTitle>Mekanoitler menüsü, {0} mekanoit</RimWorldAccess.Mechs.Menu.OpeningTitle>
  <RimWorldAccess.Mechs.Menu.Closed>Mekanoitler menüsü kapatıldı</RimWorldAccess.Mechs.Menu.Closed>
  <RimWorldAccess.Mechs.Menu.NoMechs>Mekanoit yok</RimWorldAccess.Mechs.Menu.NoMechs>
  <RimWorldAccess.Mechs.Menu.NotOnMap>Mekanoit haritada değil</RimWorldAccess.Mechs.Menu.NotOnMap>

  <!-- =================================================================
       Draft column interaction (Enter on Draft cell). CannotDraft is the
       fallback spoken only when the game supplies no reason of its own;
       the game's own reason text is spoken verbatim when present. -->
  <RimWorldAccess.Mechs.Draft.CannotDraftThisMech>Bu mekanoit çatışma moduna alınamaz</RimWorldAccess.Mechs.Draft.CannotDraftThisMech>
  <RimWorldAccess.Mechs.Draft.CannotDraft>Çatışma moduna alınamaz</RimWorldAccess.Mechs.Draft.CannotDraft>

  <!-- Auto-repair column interaction. -->
  <RimWorldAccess.Mechs.AutoRepair.NoComponent>Oto-tamir bileşeni yok</RimWorldAccess.Mechs.AutoRepair.NoComponent>

  <!-- =================================================================
       Submenu (Control Group / Work Mode / Allowed Area).
       Open-time errors first, then the option-row phrasing.
       CurrentMarker: {0} = the option label; marks the mech's current value.
       Option: {0} = option label, {1} = position suffix (typeahead variant).
       OptionAnnounce: {0} = option label, {1} = position suffix.
       OptionWithDesc: {0} = option label, {1} = work-mode description,
         {2} = position suffix. -->
  <RimWorldAccess.Mechs.Submenu.NoOverseer>Gözetmen yok</RimWorldAccess.Mechs.Submenu.NoOverseer>
  <RimWorldAccess.Mechs.Submenu.NoControlGroup>Kontrol grubu yok</RimWorldAccess.Mechs.Submenu.NoControlGroup>
  <!-- Spoken instead of applying an allowed area when the mech fails
       vanilla's own compound gate (most commonly: no live overseer) —
       mirrors PawnColumnWorker_AllowedArea's DoCell, which draws no selector
       at all for such a mech. -->
  <RimWorldAccess.Mechs.Submenu.AreaNotAllowed>{0}: izinli alan atanamaz</RimWorldAccess.Mechs.Submenu.AreaNotAllowed>
  <RimWorldAccess.Mechs.Submenu.CurrentMarker>{0} (mevcut)</RimWorldAccess.Mechs.Submenu.CurrentMarker>
  <RimWorldAccess.Mechs.Submenu.Option>{0}. {1}</RimWorldAccess.Mechs.Submenu.Option>
  <RimWorldAccess.Mechs.Submenu.OptionAnnounce>{0} ({1})</RimWorldAccess.Mechs.Submenu.OptionAnnounce>
  <RimWorldAccess.Mechs.Submenu.OptionWithDesc>{0}. {1} ({2})</RimWorldAccess.Mechs.Submenu.OptionWithDesc>

  <!-- Control-group submenu apply feedback. -->
  <RimWorldAccess.Mechs.ControlGroup.AlreadyInGroup>Zaten bu grupta</RimWorldAccess.Mechs.ControlGroup.AlreadyInGroup>

  <!-- Work-mode submenu apply feedback. SetForGroup: {0} = work-mode label,
       {1} = control-group index. -->
  <RimWorldAccess.Mechs.WorkMode.AlreadySet>Zaten bu moda ayarlı</RimWorldAccess.Mechs.WorkMode.AlreadySet>
  <RimWorldAccess.Mechs.WorkMode.SetForGroup>{1} numaralı kontrol grubu için çalışma modu {0} olarak ayarlandı</RimWorldAccess.Mechs.WorkMode.SetForGroup>

  <!-- =================================================================
       Sort feedback (Alt+S). Mirrors the Animals sort vocabulary.
       CannotSort/SortedBy: {0} = column name, {1} = direction word.
       NowAt: {0} = the rebuilt cell announcement after a resort. -->
  <RimWorldAccess.Mechs.Sort.NowAt>Şimdi {0}</RimWorldAccess.Mechs.Sort.NowAt>

  <!-- =================================================================
       Single-step paint (Shift+Down / Shift+Up).
       Allowed Area: {0} = mech name, {1} = area label, {2} = position. -->
  <RimWorldAccess.Mechs.Paint.Single.AreaAlreadySet>{0}: zaten {1} olarak ayarlı. {2}</RimWorldAccess.Mechs.Paint.Single.AreaAlreadySet>
  <RimWorldAccess.Mechs.Paint.Single.AreaApplied>{0}: {1} uygulandı. {2}</RimWorldAccess.Mechs.Paint.Single.AreaApplied>
  <!-- Spoken instead of AreaApplied when the target fails vanilla's own
       compound gate (see PawnColumnWorker_AllowedArea.DoCell — most commonly:
       no live overseer) — the write was correctly skipped, so this must not
       claim success. -->
  <RimWorldAccess.Mechs.Paint.Single.AreaNotAllowed>{0}: izinli alan atanamaz. {1}</RimWorldAccess.Mechs.Paint.Single.AreaNotAllowed>

  <!-- Single-step paint for Draft / Auto Repair checkbox columns.
       {0} = mech name, {1} = column name, {2} = value label, {3} = position.
       CannotApply: {0} = mech name, {1} = column name, {2} = position. -->
  <RimWorldAccess.Mechs.Paint.Single.CellAlready>{0}: {1} zaten {2}. {3}</RimWorldAccess.Mechs.Paint.Single.CellAlready>
  <RimWorldAccess.Mechs.Paint.Single.CellApplied>{0}: {1} {2}. {3}</RimWorldAccess.Mechs.Paint.Single.CellApplied>
  <RimWorldAccess.Mechs.Paint.Single.CannotApply>{0}: {1} uygulanamıyor. {2}</RimWorldAccess.Mechs.Paint.Single.CannotApply>

  <!-- Single-step paint for the Control Group column. {0} = mech name,
       {1} = control-group index (where applicable), {2} = position. The
       "no source group" case takes no mech name (the source has nothing to
       copy), so it is a bare phrase. -->
  <RimWorldAccess.Mechs.Paint.ControlGroup.NoGroupToPaint>Boyanacak kontrol grubu yok</RimWorldAccess.Mechs.Paint.ControlGroup.NoGroupToPaint>
  <RimWorldAccess.Mechs.Paint.ControlGroup.GestatingCannotAssign>{0}: montajlanıyor, atanamaz. {1}</RimWorldAccess.Mechs.Paint.ControlGroup.GestatingCannotAssign>
  <RimWorldAccess.Mechs.Paint.ControlGroup.DifferentOverseer>{0}: farklı gözetmen, boyanamaz. {1}</RimWorldAccess.Mechs.Paint.ControlGroup.DifferentOverseer>
  <RimWorldAccess.Mechs.Paint.ControlGroup.AlreadyInGroup>{0}: zaten {1} numaralı grupta. {2}</RimWorldAccess.Mechs.Paint.ControlGroup.AlreadyInGroup>
  <RimWorldAccess.Mechs.Paint.ControlGroup.AssignedToGroup>{0}: {1} numaralı gruba atandı. {2}</RimWorldAccess.Mechs.Paint.ControlGroup.AssignedToGroup>

  <!-- =================================================================
       Bulk paint summaries (Shift+Home / Shift+End / Ctrl+Shift+...).
       Allowed Area: {0} = column name, {1} = area label, {2} = name list.
       AreaAlreadyAll: {0} = area label.
       Group: {0} = column name, {1} = group index, {2} = name list.
       GroupAlreadyAll: {0} = group index (covers "or different overseer").
       Checkbox columns: {0} = column name, {1} = value label, {2} = list.
       CellAlreadyAll: {0} = column name, {1} = value label. -->
  <RimWorldAccess.Mechs.Paint.Bulk.AreaApplied>{2} için {0} {1} olarak boyandı</RimWorldAccess.Mechs.Paint.Bulk.AreaApplied>
  <RimWorldAccess.Mechs.Paint.Bulk.AreaAlreadyAll>Tümü zaten {0} olarak ayarlı</RimWorldAccess.Mechs.Paint.Bulk.AreaAlreadyAll>
  <RimWorldAccess.Mechs.Paint.Bulk.GroupApplied>{2} için {0}: {1} numaralı gruba boyandı</RimWorldAccess.Mechs.Paint.Bulk.GroupApplied>
  <RimWorldAccess.Mechs.Paint.Bulk.GroupAlreadyAll>Tümü zaten {0} numaralı grupta (veya farklı gözetmen)</RimWorldAccess.Mechs.Paint.Bulk.GroupAlreadyAll>
  <RimWorldAccess.Mechs.Paint.Bulk.CellApplied>{2} için {0} {1} olarak boyandı</RimWorldAccess.Mechs.Paint.Bulk.CellApplied>
  <RimWorldAccess.Mechs.Paint.Bulk.CellAlreadyAll>Tümü zaten {1}</RimWorldAccess.Mechs.Paint.Bulk.CellAlreadyAll>


  <!-- Percentage range readout: {0} = min percent, {1} = max percent. -->
  <RimWorldAccess.Mechs.PercentRange>{0} - {1}</RimWorldAccess.Mechs.PercentRange>
</LanguageData>
