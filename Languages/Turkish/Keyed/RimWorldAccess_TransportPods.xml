  <RimWorldAccess.TransportPods.Loading.StatMassCapacity>Ağırlık kapasitesi</RimWorldAccess.TransportPods.Loading.StatMassCapacity>
  <RimWorldAccess.TransportPods.Loading.StatSpeed>Hız</RimWorldAccess.TransportPods.Loading.StatSpeed>
