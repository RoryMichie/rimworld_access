  <RimWorldAccess.TransportPods.Selection.PodDeselected>Kapsül seçimi kaldırıldı. {0} seçili</RimWorldAccess.TransportPods.Selection.PodDeselected>

  <!-- Confirmation errors (ConfirmSelection). -->
  <RimWorldAccess.TransportPods.Selection.NoPodsSelected>Seçili kapsül yok. Kapsüllere ok tuşuyla git ve seçmek için Boşluk tuşuna bas.</RimWorldAccess.TransportPods.Selection.NoPodsSelected>
  <RimWorldAccess.TransportPods.Selection.PodsUnavailable>Seçili kapsüller artık kullanılamıyor</RimWorldAccess.TransportPods.Selection.PodsUnavailable>
  <RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>Yükleme komutu bulunamadı. Kapsül zaten yükleniyor olabilir.</RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>

  <!-- =========================================================
       TransportPodLoadingState.cs - Dialog_LoadTransporters keyboard nav.
       ========================================================= -->

  <!-- Open guards. -->
  <RimWorldAccess.TransportPods.Loading.ReflectionFailed>Taşıma kapsülü yükleme ekranının erişilebilirliği oyun güncellemesi nedeniyle kullanılamıyor. Lütfen mod güncellemelerini kontrol et.</RimWorldAccess.TransportPods.Loading.ReflectionFailed>

  <!-- Entry announcement. One/Many split so translators control pod/pods
       agreement; the pod-noun key is inlined into the sentence so word order
       stays natural across languages.
       {0} = pod count, {1} = total mass capacity. -->
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>Taşıma kapsülünü yükle. {0} kapsül, {1} kg kapasite. Sekmeler için Sol/Sağ, ayarlamak için Enter.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>Taşıma kapsülünü yükle. {0} kapsül, {1} kg kapasite. Sekmeler için Sol/Sağ, ayarlamak için Enter.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>

  <!-- Tab navigation. -->

  <!-- Shared empty-tab feedback (spoken in multiple navigation paths). -->

  <!-- Activation and quantity actions. {0} = item label. -->
