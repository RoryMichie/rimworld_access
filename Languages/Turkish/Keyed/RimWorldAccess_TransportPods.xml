  <!-- Delete/remove guard. -->
  <RimWorldAccess.TransportPods.Loading.AlreadyAtZero>Zaten sıfırda</RimWorldAccess.TransportPods.Loading.AlreadyAtZero>

  <!-- Reset (Alt+R). -->
  <RimWorldAccess.TransportPods.Loading.ResetAll>Tüm öğeler sıfırlandı</RimWorldAccess.TransportPods.Loading.ResetAll>

  <!-- Mass summary (Tab key / AnnounceMassSummary).
       Composed from MassLine + one of OverloadedStatus/RemainingStatus.
       {0} = current usage, {1} = capacity, {2} = status clause. -->

