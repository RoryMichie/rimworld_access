  <!-- Cancellation (Close). -->
  <RimWorldAccess.TransportPods.Selection.Cancelled>Kapsül seçimi iptal edildi</RimWorldAccess.TransportPods.Selection.Cancelled>

  <!-- Per-toggle feedback (TogglePodAtCursor). {0} = current selected count. -->
