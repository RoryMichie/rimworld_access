  <RimWorldAccess.TransportPods.Loading.ItemUnchecked>{0} işareti kaldırıldı</RimWorldAccess.TransportPods.Loading.ItemUnchecked>
  <RimWorldAccess.TransportPods.Loading.ItemRemoved>{0} kaldırıldı</RimWorldAccess.TransportPods.Loading.ItemRemoved>

  <!-- Inspect results. -->
