<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Trade module strings (src/Trade/). Two state files contribute:
      - TradeNavigationState.cs   (Dialog_Trade keyboard navigation,
                                   3 tabs, gift mode, quantity mode,
                                   numeric input, balance entry)
      - SellableItemsState.cs     (Dialog_SellableItems read-only browse)

    The two patches (TradeNavigationPatch, SellableItemsNavigationPatch)
    have no user-facing strings and are untouched. Most data flowing
    through these announcements - tradeable labels, faction names,
    trader names, item descriptions, currency counts, royal favor
    labels, and ToStringMoney output - comes from the game and is NOT
    translated here.

    Phrasing decisions:
      - "Buying"/"Selling"/"Gifting" appear in many sentence shapes, so
        each shape is its own key (Trade.Adjust.*, Trade.Pending.*,
        Trade.Max.*) rather than glue-composing the verb. This lets
        translators inflect for case/agreement per sentence.
      - Silver prices use "${0}" (matches RimWorld's ToStringMoney) and
        favor uses "{0} favor". Both go through Trade.Price.Silver/Favor
        so non-English currencies can pick a different symbol/order.
      - "favor" / "silver" appear as standalone nouns inside other
        sentences (balance, currency holdings) - separate keys.
      - Item announcements compose smaller sentence fragments joined by
        "{0}." in C#; each fragment is a key so the join character can
        be changed per language.

    Shared phrases delegated elsewhere:
      - Search.Cleared / Search.NoMatches / Position / Edge -> Common.xml
      - InfoCard / Map.JumpedTo                              -> Common.xml
      - "Cannot adjust" reasons share a single Trade.Reject.* key set
        rather than 4 separate strings.
  -->

  <!-- =================================================================
       Trade dialog lifecycle (TradeNavigationState.Open / Close /
       AcceptTrade / cancel paths).
       Open: {0} = trader name, {1} = trader kind label.
       ================================================================= -->
  <RimWorldAccess.Trade.Open.Heading>Negociando com {0} ({1}). Alt+B para o saldo, Alt+A para confirmar.</RimWorldAccess.Trade.Open.Heading>
  <RimWorldAccess.Trade.Open.UnknownTrader>Negociante desconhecido</RimWorldAccess.Trade.Open.UnknownTrader>
  <RimWorldAccess.Trade.Open.TraderKindFallback>comerciante</RimWorldAccess.Trade.Open.TraderKindFallback>
  <RimWorldAccess.Trade.Open.NoDialog>Nenhum diálogo de negociação</RimWorldAccess.Trade.Open.NoDialog>
  <RimWorldAccess.Trade.Open.NoSession>Nenhuma sessão de negociação ativa</RimWorldAccess.Trade.Open.NoSession>
  <RimWorldAccess.Trade.Open.SessionNotInitialized>Sessão de negociação não inicializada corretamente</RimWorldAccess.Trade.Open.SessionNotInitialized>
  <RimWorldAccess.Trade.Cancelled>Negociação cancelada</RimWorldAccess.Trade.Cancelled>

  <!-- =================================================================
       Tab / category names.
       TraderItems is composed: "{0}'s Items" with {0} = trader name.
       Tab.Empty: {0} = category name, used when the tab has 0 items.
       Tab.SwitchedTo composes the category name with a currency
       suffix: {0} = category name, {1} = currency phrase
       (Trade.Currency.YouHave / TraderHas).
       ================================================================= -->

  <!-- Currency holdings phrasing (Alt+B and tab-switch suffix).
       YouHave / TraderHas: {0} = formatted currency string. -->
  <RimWorldAccess.Trade.Currency.Both>Você tem {0}. O comerciante tem {1}</RimWorldAccess.Trade.Currency.Both>
  <RimWorldAccess.Trade.Currency.None>Nenhuma moeda disponível</RimWorldAccess.Trade.Currency.None>
  <!-- Bare nouns used inside larger sentences ("X silver", "X favor"). -->
  <RimWorldAccess.Trade.Currency.SilverNoun>prata</RimWorldAccess.Trade.Currency.SilverNoun>
  <RimWorldAccess.Trade.Currency.FavorNoun>favor</RimWorldAccess.Trade.Currency.FavorNoun>
  <!-- Favor count format: {0} = integer count of favor.
       Silver uses RimWorld's float.ToStringMoney() ("$N"); we leave
       that to the game. -->
  <RimWorldAccess.Trade.Currency.FavorCount>{0} de favor</RimWorldAccess.Trade.Currency.FavorCount>

  <!-- Price formatting (FormatPrice). Silver matches ToStringMoney's
       "$N" prefix; Favor: "{0} favor". {0} = formatted number. -->
  <RimWorldAccess.Trade.Price.Favor>{0} de favor</RimWorldAccess.Trade.Price.Favor>

  <!-- =================================================================
       Quantity-adjust feedback (single-step Up/Down arrow).
       AnnounceQuantityChange composes:
         {label}: No trade  (when transfer hits zero)
         {action} {count} {label}, value {price}
       Buying/Selling/Gifting are split into action-specific keys so
       each sentence shape can vary per language.
       ================================================================= -->
  <RimWorldAccess.Trade.Adjust.NoTrade>{0}: sem negociação</RimWorldAccess.Trade.Adjust.NoTrade>
  <RimWorldAccess.Trade.Adjust.Buying>Comprando {0} {1}, valor {2}</RimWorldAccess.Trade.Adjust.Buying>
  <RimWorldAccess.Trade.Adjust.Selling>Vendendo {0} {1}, valor {2}</RimWorldAccess.Trade.Adjust.Selling>
  <RimWorldAccess.Trade.Adjust.Gifting>Doando {0} {1}, valor {2}</RimWorldAccess.Trade.Adjust.Gifting>

  <!-- Max-action announcements (Home/End set to extreme).
       Reset: {0} = item label.
       Buying/Selling/Gifting: {0} = count, {1} = item label,
                                {2} = formatted price. -->

  <!-- Reset action (Alt+R). {0} = item label. -->
  <RimWorldAccess.Trade.Reset.AllTrades>Todas as negociações redefinidas</RimWorldAccess.Trade.Reset.AllTrades>

  <!-- =================================================================
       Pending-trade announcement on the list view.
       Pending.WithCount: {0} = action verb word, {1} = count.
       Pending.PriceLine: {0} = "Total"/"Value", {1} = formatted price.
       Each action ("Buying"/"Selling"/"Gifting") is a separate key so
       it can flex with grammatical case in non-English. -->
  <RimWorldAccess.Trade.Pending.ActionBuying>Comprando</RimWorldAccess.Trade.Pending.ActionBuying>
  <RimWorldAccess.Trade.Pending.ActionSelling>Vendendo</RimWorldAccess.Trade.Pending.ActionSelling>
  <RimWorldAccess.Trade.Pending.ActionGifting>Doando</RimWorldAccess.Trade.Pending.ActionGifting>
  <RimWorldAccess.Trade.Pending.ActionWithCount>{0} {1}</RimWorldAccess.Trade.Pending.ActionWithCount>
  <RimWorldAccess.Trade.Pending.PriceLabelTotal>Total</RimWorldAccess.Trade.Pending.PriceLabelTotal>
  <RimWorldAccess.Trade.Pending.PriceLabelValue>Valor</RimWorldAccess.Trade.Pending.PriceLabelValue>
  <RimWorldAccess.Trade.Pending.PriceLine>{0}: {1}</RimWorldAccess.Trade.Pending.PriceLine>

  <!-- =================================================================
       Item announcement composition for the inventory tabs.
       *.SoloAvailable: only one party has the item; {0} = count.
       *.SoloPrice: bare price line, {0} = formatted price.
       *.SoloPriceWithQuality: with price-quality suffix; {0} = price,
                              {1} = quality phrase.
       *.NotTradeable: trader will not trade this item.
       *.YoursAt / TheirsAt: shared item; {0} = count, {1} = price.
       *.YoursAtWithQuality / TheirsAtWithQuality: same plus quality;
                              {0} = count, {1} = price, {2} = quality.
       *.YoursOnly / TheirsOnly: shared but trader won't trade;
                              {0} = count.
       ================================================================= -->

  <!-- Price quality words (GetPriceQuality). Buying = lower=better,
       Selling = higher=better; the four PriceType buckets get separate
       words for each direction. -->
  <RimWorldAccess.Trade.Quality.Buy.VeryCheap>ótimo negócio</RimWorldAccess.Trade.Quality.Buy.VeryCheap>
  <RimWorldAccess.Trade.Quality.Buy.Cheap>bom negócio</RimWorldAccess.Trade.Quality.Buy.Cheap>
  <RimWorldAccess.Trade.Quality.Buy.Expensive>caro</RimWorldAccess.Trade.Quality.Buy.Expensive>
  <RimWorldAccess.Trade.Quality.Buy.Exorbitant>muito caro</RimWorldAccess.Trade.Quality.Buy.Exorbitant>
  <RimWorldAccess.Trade.Quality.Sell.VeryCheap>oferta ruim</RimWorldAccess.Trade.Quality.Sell.VeryCheap>
  <RimWorldAccess.Trade.Quality.Sell.Cheap>oferta baixa</RimWorldAccess.Trade.Quality.Sell.Cheap>
  <RimWorldAccess.Trade.Quality.Sell.Expensive>boa oferta</RimWorldAccess.Trade.Quality.Sell.Expensive>
  <RimWorldAccess.Trade.Quality.Sell.Exorbitant>ótima oferta</RimWorldAccess.Trade.Quality.Sell.Exorbitant>

  <!-- =================================================================
       Quantity adjustment mode.
       Mode.Adjusting is the constant marker word; {0} = upper bound.
       Each context (gift, shared, sell-only, buy-only) is a separate
       sentence so word order can vary. -->

  <!-- =================================================================
       Reject / error paths.
       ================================================================= -->
  <RimWorldAccess.Trade.Reject.WillNotTrade>O comerciante não deseja negociar este item</RimWorldAccess.Trade.Reject.WillNotTrade>
  <RimWorldAccess.Trade.Reject.CannotAdjustAmount>Impossível ajustar para esta quantidade</RimWorldAccess.Trade.Reject.CannotAdjustAmount>

  <!-- =================================================================
       Numeric input mode (digit/sign keys in quantity mode).
       Numeric.PromptSelling / Buying / Gifting are spoken when the
       user presses a sign key with an empty buffer.
       Numeric.Typing: {0} = current numeric buffer string.
       Numeric.Cleared / Numeric.Invalid mark transitional states. -->
  <!-- After a numeric edit, the announcement is composed from one of
       the *.Body keys plus the *.Suffix key.
       NoTradeBody: {0} = item label.
       BuyingBody / SellingBody / GiftingBody: {0} = action verb,
       {1} = count, {2} = item label.
       BuyingBodyWithPrice / SellingBodyWithPrice: same plus
       {3} = formatted price. Suffix: {0} = current buffer. -->

