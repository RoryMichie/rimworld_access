<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Combat module strings (src/Combat/). Three files contribute:
      - CombatLogState.cs  (Alt+B combat log viewer)
      - ShellImpactPatch.cs  (mortar/artillery impact announcements)
      - TargetingPatch.cs  (Enter-to-target, range/LOS feedback, multi-select)

    The multi-select keys (Combat.MultiSelect.*) exist as whole phrases per
    semantic case so translators can reorder subject/verb/object freely. C#
    picks which key to use based on succeeded/unchanged pawn counts. Singular
    and plural subject forms are separate keys because English needs subject-
    verb agreement ("Only Bob attacks" vs "Only Bob and Alice attack"); other
    languages can collapse or split these further in their own XML.
  -->

  <!-- Combat log (Alt+B). -->
  <RimWorldAccess.Combat.Log.NoBattleLog>Nenhum registro de batalha disponível</RimWorldAccess.Combat.Log.NoBattleLog>
  <RimWorldAccess.Combat.Log.Header>Registro de combate de {0}</RimWorldAccess.Combat.Log.Header>
  <RimWorldAccess.Combat.Log.BattleHeader>Batalha: {0}.</RimWorldAccess.Combat.Log.BattleHeader>
  <RimWorldAccess.Combat.Log.NoEntries>Nenhuma entrada de combate encontrada.</RimWorldAccess.Combat.Log.NoEntries>
  <RimWorldAccess.Combat.Log.ShowingLastN>Mostrando as últimas 10 de {0} entradas.</RimWorldAccess.Combat.Log.ShowingLastN>
  <RimWorldAccess.Combat.Log.Total>Total: {0} entradas.</RimWorldAccess.Combat.Log.Total>

  <!-- Shell impacts (mortars, artillery). {0} = shell source label,
       {1} = target label (Hit only), last two = impact cell x, z. -->
  <RimWorldAccess.Combat.Shell.SourceDefault>Projétil</RimWorldAccess.Combat.Shell.SourceDefault>
  <RimWorldAccess.Combat.Shell.SourceOurs>Nosso projétil</RimWorldAccess.Combat.Shell.SourceOurs>
  <RimWorldAccess.Combat.Shell.SourceEnemy>Projétil inimigo</RimWorldAccess.Combat.Shell.SourceEnemy>
  <RimWorldAccess.Combat.Shell.Hit>{0} atingiu {1} em {2}, {3}</RimWorldAccess.Combat.Shell.Hit>
  <RimWorldAccess.Combat.Shell.Landed>{0} caiu em {1}, {2}</RimWorldAccess.Combat.Shell.Landed>

  <!-- Generic target and location fallbacks. Used when target.HasThing is
       false and a labeled placeholder is needed for sentence composition. -->
  <RimWorldAccess.Combat.Target.GenericTargetLabel>alvo</RimWorldAccess.Combat.Target.GenericTargetLabel>
  <RimWorldAccess.Combat.Target.GenericLocationLabel>local</RimWorldAccess.Combat.Target.GenericLocationLabel>

  <!-- Range/distance feedback during targeting. -->
  <RimWorldAccess.Combat.Target.NoRangeInfo>Nenhuma informação de alcance disponível</RimWorldAccess.Combat.Target.NoRangeInfo>
  <RimWorldAccess.Combat.Target.DistanceInRange>Distância: {0} células, NO ALCANCE</RimWorldAccess.Combat.Target.DistanceInRange>
  <RimWorldAccess.Combat.Target.DistanceOutOfRange>Distância: {0} células, FORA DE ALCANCE (máx. {1})</RimWorldAccess.Combat.Target.DistanceOutOfRange>
  <RimWorldAccess.Combat.Target.OutOfRange>Fora de alcance. Distância: {0}, alcance máximo: {1}</RimWorldAccess.Combat.Target.OutOfRange>

  <!-- Target validation and errors. -->
  <RimWorldAccess.Combat.Target.InvalidPosition>Posição de alvo inválida</RimWorldAccess.Combat.Target.InvalidPosition>
  <RimWorldAccess.Combat.Target.InvalidTarget>Alvo inválido</RimWorldAccess.Combat.Target.InvalidTarget>
  <RimWorldAccess.Combat.Target.NotValidTarget>{0} não é um alvo válido</RimWorldAccess.Combat.Target.NotValidTarget>
  <RimWorldAccess.Combat.Target.NoValidAtCursorWithDesc>Nenhum alvo válido no cursor. {0}</RimWorldAccess.Combat.Target.NoValidAtCursorWithDesc>
  <RimWorldAccess.Combat.Target.NoActionAvailable>Nenhuma ação de mira disponível</RimWorldAccess.Combat.Target.NoActionAvailable>
  <RimWorldAccess.Combat.Target.ErrorUsing>Erro ao usar no alvo: {0}</RimWorldAccess.Combat.Target.ErrorUsing>

  <!-- Targeting success announcements (single-select path). -->
  <RimWorldAccess.Combat.Target.Targeting>Visando: {0}</RimWorldAccess.Combat.Target.Targeting>
  <RimWorldAccess.Combat.Target.TargetingLocation>Visando local</RimWorldAccess.Combat.Target.TargetingLocation>
  <RimWorldAccess.Combat.Target.Selected>Alvo selecionado: {0}</RimWorldAccess.Combat.Target.Selected>

  <!-- Second-phase (destination) selection, e.g. Skip ability. -->
  <RimWorldAccess.Combat.Target.SelectDestination>Agora selecione o destino</RimWorldAccess.Combat.Target.SelectDestination>
  <RimWorldAccess.Combat.Target.SelectDestinationInRange>Agora selecione o destino em até {0} células</RimWorldAccess.Combat.Target.SelectDestinationInRange>

  <!-- Ranged shot report: press 1 over a target with a drafted shooter
       selected. The contributing-factor breakdown is RimWorld's own localized
       ShotReport.GetTextReadout() text; we only supply the headline that
       replaces vanilla's awkward "Shot by X:" line, and the cannot-hit line.
       Headline: {0} = target label, {1} = total hit-chance percent.
       HeadlineGeneric is the fallback for miss-radius weapons (e.g. grenades)
       whose readout does not lead with a single hit-chance figure. -->
  <RimWorldAccess.Combat.ShotReport.Headline>{0}, {1} de chance de acerto</RimWorldAccess.Combat.ShotReport.Headline>
  <RimWorldAccess.Combat.ShotReport.HeadlineGeneric>{0}</RimWorldAccess.Combat.ShotReport.HeadlineGeneric>
  <RimWorldAccess.Combat.ShotReport.CannotHit>{0}: impossível acertar</RimWorldAccess.Combat.ShotReport.CannotHit>

  <!-- Multi-select attack feedback. Whole-phrase keys per semantic case so
       word order and subject-verb agreement can be localized naturally.
         Everyone:  all selected pawns accepted the order.
         NoOne:     none of the selected pawns accepted the order.
         Only:      some accepted, fewer accepted than rejected.
         Except:    some rejected, fewer rejected than accepted.
       English uses singular "attacks" for the Everyone and EveryoneExcept
       forms because "everyone" takes singular agreement. Only has split
       singular/plural forms because its subject is the name list itself.
       Translators can collapse or further split these as their grammar requires.
       {0} = everyone-label from vanilla key (Except) or name-list (Only),
       {1} = name-list of the exception / attack target,
       {2} = attack target (Except key only). -->
  <!-- {0} resolves to vanilla's "Todos" (ConfirmAbandonHomeNegativeThoughts_Everyone),
       a plural subject in Portuguese, so these two use the plural verb "atacam"
       rather than mirroring English's singular "attacks". -->
  <RimWorldAccess.Combat.MultiSelect.EveryoneAttacks>{0} atacam {1}</RimWorldAccess.Combat.MultiSelect.EveryoneAttacks>
  <RimWorldAccess.Combat.MultiSelect.NoOneCouldAttack>Ninguém pôde atacar {0}</RimWorldAccess.Combat.MultiSelect.NoOneCouldAttack>
  <RimWorldAccess.Combat.MultiSelect.EveryoneExceptAttacks>{0}, exceto {1}, atacam {2}</RimWorldAccess.Combat.MultiSelect.EveryoneExceptAttacks>
  <RimWorldAccess.Combat.MultiSelect.OnlyOneAttacks>Apenas {0} ataca {1}</RimWorldAccess.Combat.MultiSelect.OnlyOneAttacks>
  <RimWorldAccess.Combat.MultiSelect.OnlyManyAttack>Apenas {0} atacam {1}</RimWorldAccess.Combat.MultiSelect.OnlyManyAttack>
</LanguageData>
