  <RimWorldAccess.Abilities.Affected.NoPawnsInRadius>Nenhum personagem dentro do raio de efeito</RimWorldAccess.Abilities.Affected.NoPawnsInRadius>
  <RimWorldAccess.Abilities.Affected.TargetOne>Alvo: {0}</RimWorldAccess.Abilities.Affected.TargetOne>
  <RimWorldAccess.Abilities.Affected.CountPrefix>Afetados: {0} - {1}</RimWorldAccess.Abilities.Affected.CountPrefix>
  <RimWorldAccess.Abilities.Affected.AndMore>, e mais {0}</RimWorldAccess.Abilities.Affected.AndMore>

  <!-- Immunity message. {0} = pawn label. -->
