<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Configure Spoken Announcements screen (src/Shell/Screens/AnnouncementConfigDialog.Game.cs
    — Dialog_ConfigureAnnouncements / AnnouncementConfigScope). Opened from a button in both
    RimWorld Access settings surfaces (see RimWorldAccess_Core.xml's
    RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button).

    The seven part names/examples are read top-to-bottom in the canonical order; the example
    fragments show a translator exactly what that part sounds like in an announcement so they
    can adapt the sample text to their own language's phrasing.
  -->

  <RimWorldAccess.AnnounceConfig.Title>Налаштувати озвучені оголошення</RimWorldAccess.AnnounceConfig.Title>
  <RimWorldAccess.AnnounceConfig.Intro>Виберіть, які частини оголошення озвучуються і в якому порядку вони звучать. Зміни застосовуються одразу, тож ви можете почути результат, переглядаючи цей список. Натисніть Пробіл або Enter, щоб перемкнути частину, і Ctrl зі стрілками вгору та вниз, щоб перемістити її.</RimWorldAccess.AnnounceConfig.Intro>
  <RimWorldAccess.AnnounceConfig.PartsRegion>Частини оголошення</RimWorldAccess.AnnounceConfig.PartsRegion>

  <!-- The Name part's row is always drawn checked and disabled; see
       RimWorldAccess.AnnounceConfig.NameAlwaysOn below. -->
  <RimWorldAccess.AnnounceConfig.Part.Label>Назва</RimWorldAccess.AnnounceConfig.Part.Label>
  <RimWorldAccess.AnnounceConfig.Part.Hotkey>Гаряча клавіша</RimWorldAccess.AnnounceConfig.Part.Hotkey>
  <RimWorldAccess.AnnounceConfig.Part.Role>Тип елемента керування</RimWorldAccess.AnnounceConfig.Part.Role>
  <RimWorldAccess.AnnounceConfig.Part.State>Стан елемента керування</RimWorldAccess.AnnounceConfig.Part.State>
  <RimWorldAccess.AnnounceConfig.Part.Level>Рівень вкладеності</RimWorldAccess.AnnounceConfig.Part.Level>
  <RimWorldAccess.AnnounceConfig.Part.Position>Позиція у списку</RimWorldAccess.AnnounceConfig.Part.Position>
  <RimWorldAccess.AnnounceConfig.Part.Extras>Опис і деталі</RimWorldAccess.AnnounceConfig.Part.Extras>
  <RimWorldAccess.AnnounceConfig.Part.Hint>Підказки щодо взаємодії</RimWorldAccess.AnnounceConfig.Part.Hint>

  <RimWorldAccess.AnnounceConfig.Example.Label>наприклад: Дозволити свіжі трупи</RimWorldAccess.AnnounceConfig.Example.Label>
  <RimWorldAccess.AnnounceConfig.Example.Hotkey>наприклад: Alt+C</RimWorldAccess.AnnounceConfig.Example.Hotkey>
  <RimWorldAccess.AnnounceConfig.Example.Role>наприклад: прапорець</RimWorldAccess.AnnounceConfig.Example.Role>
  <RimWorldAccess.AnnounceConfig.Example.State>наприклад: позначено</RimWorldAccess.AnnounceConfig.Example.State>
  <RimWorldAccess.AnnounceConfig.Example.Level>наприклад: рівень 2</RimWorldAccess.AnnounceConfig.Example.Level>
  <RimWorldAccess.AnnounceConfig.Example.Position>наприклад: 4 з 13</RimWorldAccess.AnnounceConfig.Example.Position>
  <RimWorldAccess.AnnounceConfig.Example.Extras>наприклад: Включно з гнилими</RimWorldAccess.AnnounceConfig.Example.Extras>
  <RimWorldAccess.AnnounceConfig.Example.Hint>наприклад: Натисніть Enter, щоб вибрати</RimWorldAccess.AnnounceConfig.Example.Hint>

  <!-- Spoken (as Extras, after the example fragment) and appended in place of the toggle
       when the player tries to act on the Name part's row; it can be reordered but never
       turned off, since silencing it would leave the player unable to tell what is focused. -->
  <RimWorldAccess.AnnounceConfig.NameAlwaysOn>Назва елемента озвучується завжди.</RimWorldAccess.AnnounceConfig.NameAlwaysOn>

  <RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition>Позиція рядка та стовпця в таблицях</RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition>
  <RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition.Example>наприклад: рядок 3 з 8, стовпець 2 з 5</RimWorldAccess.AnnounceConfig.Extra.RowColumnPosition.Example>
  <RimWorldAccess.AnnounceConfig.Extra.TableDimensions>Розмір таблиці під час входу в таблицю</RimWorldAccess.AnnounceConfig.Extra.TableDimensions>
  <RimWorldAccess.AnnounceConfig.Extra.TableDimensions.Example>наприклад: таблиця, стовпців: 5, рядків: 8</RimWorldAccess.AnnounceConfig.Extra.TableDimensions.Example>
  <RimWorldAccess.AnnounceConfig.Extra.SectionCount>Скільки розділів має екран і в якому ви перебуваєте</RimWorldAccess.AnnounceConfig.Extra.SectionCount>
  <RimWorldAccess.AnnounceConfig.Extra.SectionCount.Example>наприклад: розділів: 2, або розділ 2 з 3</RimWorldAccess.AnnounceConfig.Extra.SectionCount.Example>

  <!-- The Preview button's canned demo item, composed live through the same ComposeFocus
       path as every real announcement, so it always reflects the current working toggles/order. -->
  <RimWorldAccess.AnnounceConfig.Preview.Button>Прослухати оголошення</RimWorldAccess.AnnounceConfig.Preview.Button>
  <RimWorldAccess.AnnounceConfig.Preview.Label>Приклад елемента</RimWorldAccess.AnnounceConfig.Preview.Label>
  <RimWorldAccess.AnnounceConfig.Preview.Hotkey>Alt+P</RimWorldAccess.AnnounceConfig.Preview.Hotkey>
  <RimWorldAccess.AnnounceConfig.Preview.Extras>Це приклад опису, що показує, які деталі надає власний текст елемента.</RimWorldAccess.AnnounceConfig.Preview.Extras>
  <RimWorldAccess.AnnounceConfig.Preview.Hint>Натисніть Enter, щоб вибрати.</RimWorldAccess.AnnounceConfig.Preview.Hint>

  <!-- Spoken once when the Restore defaults button or its chord runs. The button's own caption
       reuses Core's RestoreToDefaultSettings, the same way Save and Cancel reuse Core's. -->
  <RimWorldAccess.AnnounceConfig.ResetToDefaults.Done>Налаштування оголошень скинуто до типових значень.</RimWorldAccess.AnnounceConfig.ResetToDefaults.Done>
</LanguageData>
