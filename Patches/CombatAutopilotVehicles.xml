<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Vehicle Framework: drafted vehicles with a hunting policy run the mod's own raid
       AI movement (position turrets, advance on hostiles) ahead of their idle node.
       Vehicles.* classes appear only inside this guard, so an absent mod resolves nothing. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vehicle Framework</li>
    </mods>
    <match Class="PatchOperationInsert">
      <xpath>Defs/ThinkTreeDef[defName="Vehicle"]/thinkRoot/subNodes/li[@Class="ThinkNode_Tagger"]</xpath>
      <value>
        <li Class="RimWorldAccess.ThinkNode_ConditionalVehicleAutopilot">
          <subNodes>
            <li Class="Vehicles.ThinkNode_ConditionalHasTurret">
              <subNodes>
                <li Class="Vehicles.JobGiver_RangedSupport"/>
                <li Class="Vehicles.JobGiver_GotoNearestHostile"/>
              </subNodes>
            </li>
          </subNodes>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
